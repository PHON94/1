local LastMoveAt = 0

--===========================================================================
-- SOURCE MOVEMENT CORE
-- Based directly on source.txt:
--   invisible anchored block + TweenService + character follows block.
-- CheckLevel and FastAttack are intentionally outside this patch.
--===========================================================================

local block = workspace:FindFirstChild("Phongdz_SourceFarmBlock")
if block then
    pcall(function() block:Destroy() end)
end

block = Instance.new("Part")
block.Name = "Phongdz_SourceFarmBlock"
block.Size = Vector3.new(1, 1, 1)
block.Anchored = true
block.CanCollide = false
block.CanTouch = false
block.CanQuery = false
block.Transparency = 1
block.Parent = workspace

local shouldTween = false
local SourceMoveConnection = nil
local ActiveTween = nil

local function StopFarmTween()
    shouldTween = false

    if ActiveTween then
        pcall(function()
            ActiveTween:Cancel()
        end)
        ActiveTween = nil
    end
end

local function StartSourceMovement()
    if SourceMoveConnection then return end

    local root = GetRoot()
    if root then
        block.CFrame = root.CFrame
    end

    SourceMoveConnection = RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not rootPart then
            return
        end

        if not _G.AutoLevel then
            shouldTween = false
        end

        if shouldTween and block and block.Parent == workspace then
            -- TweenTo owns the character movement now. Do not overwrite
            -- HumanoidRootPart while an active tween is running.
            if not ActiveTween or ActiveTween.PlaybackState ~= Enum.PlaybackState.Playing then
                block.CFrame = rootPart.CFrame
            end

            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        else
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end)
end

local function StopSourceMovement()
    shouldTween = false
    StopFarmTween()

    if SourceMoveConnection then
        SourceMoveConnection:Disconnect()
        SourceMoveConnection = nil
    end

    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function TweenTo(target)
    if typeof(target) ~= "CFrame" then
        if typeof(target) == "Vector3" then
            target = CFrame.new(target)
        elseif typeof(target) == "Instance" and target:IsA("BasePart") then
            target = target.CFrame
        else
            return
        end
    end

    local root = GetRoot()
    if not root then return end

    StartSourceMovement()
    shouldTween = true

    -- Don't restart an already-running trip to the same destination.
    if FarmDestinationTarget
        and (FarmDestinationTarget.Position - target.Position).Magnitude <= 3
        and ActiveTween
        and ActiveTween.PlaybackState == Enum.PlaybackState.Playing then
        return
    end

    if ActiveTween then
        pcall(function()
            ActiveTween:Cancel()
        end)
        ActiveTween = nil
    end

    FarmDestinationTarget = target
    FarmDestination = target

    local distance = (target.Position - root.Position).Magnitude
    local duration = math.clamp(distance / 300, 0.15, 8)

    -- Move the character root directly. The old implementation tweened an
    -- invisible anchor but then reset that anchor to the player's position
    -- while the destination was farther than 200 studs, so long trips never
    -- actually advanced.
    ActiveTween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = target}
    )

    local tweenRef = ActiveTween
    tweenRef.Completed:Connect(function()
        if ActiveTween == tweenRef then
            ActiveTween = nil
            FarmDestinationTarget = target
            FarmDestination = target
        end
    end)

    tweenRef:Play()
end

