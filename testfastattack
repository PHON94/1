local function EnsureFlightController(root)
    if not root then return false end

    if FlightVelocity and FlightVelocity.Parent == root then
        return true
    end

    StopFlight()

    FlightAttachment = Instance.new("Attachment")
    FlightAttachment.Name = "Phongdz_FlightAttachment"
    FlightAttachment.Parent = root

    FlightVelocity = Instance.new("LinearVelocity")
    FlightVelocity.Name = "Phongdz_FlightVelocity"
    FlightVelocity.Attachment0 = FlightAttachment
    FlightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    FlightVelocity.MaxForce = math.huge
    FlightVelocity.VectorVelocity = Vector3.zero
    FlightVelocity.Parent = root

    return true
end

local function TweenTo(cf)
    local root = GetRoot()
    if not root or not cf then
        StopFlight()
        return
    end

    FlightTarget = cf.Position

    if not EnsureFlightController(root) then return end

    local delta = FlightTarget - root.Position
    local distance = delta.Magnitude

    if distance <= 3 then
        FlightVelocity.VectorVelocity = Vector3.zero
        return
    end

    local speed = math.max(50, tonumber(_G.FlySpeed) or 300)
    local desiredSpeed = speed

    -- Smoothly slow down near the target instead of stopping abruptly.
    if distance < 35 then
        desiredSpeed = math.max(70, speed * (distance / 35))
    end

    FlightVelocity.VectorVelocity = delta.Unit * desiredSpeed
end

local function EquipFarmWeapon()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local selected = _G.FarmWeapon or "Auto"

    if selected ~= "Auto" then
        local equipped = character:FindFirstChild(selected)
        if equipped and equipped:IsA("Tool") then
            return equipped
        end

        local tool = backpack and backpack:FindFirstChild(selected)
        if tool and tool:IsA("Tool") then
            pcall(function()
                humanoid:EquipTool(tool)
            end)
            return tool
        end
    end

    local current = character:FindFirstChildOfClass("Tool")
    if current then return current end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                pcall(function()
                    humanoid:EquipTool(tool)
                end)
                return tool
            end
        end
    end

    return nil
end

local function AutoHaki() local c=LocalPlayer.Character; local rem=ReplicatedStorage:FindFirstChild("Remotes"); local comm=rem and rem:FindFirstChild("CommF_"); if c and not c:FindFirstChild("HasBuso") and comm then pcall(function() comm:InvokeServer("Buso") end) end end
local AttackRemote,HitRemote
local function ResolveAttackRemotes() if AttackRemote and HitRemote then return true end; local modules=ReplicatedStorage:FindFirstChild("Modules"); local net=modules and modules:FindFirstChild("Net"); if not net then return false end; AttackRemote=net:FindFirstChild("RE/RegisterAttack"); HitRemote=net:FindFirstChild("RE/RegisterHit"); return AttackRemote~=nil and HitRemote~=nil end
local function FastAttack()
    if not ResolveAttackRemotes() then return end

    local character = LocalPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local enemies = workspace:FindFirstChild("Enemies")
    local root = GetRoot()
    if not enemies or not root then return end

    local candidates = {}

    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local head = mob:FindFirstChild("Head")

        if hum and head and hum.Health > 0 then
            local distance = (root.Position - head.Position).Magnitude
            if distance <= 60 then
                candidates[#candidates + 1] = {
                    mob = mob,
                    head = head,
                    distance = distance
                }
            end
        end
    end

    -- Nearest two mobs are grouped into the same hit packet.
    table.sort(candidates, function(a, b)
        return a.distance < b.distance
    end)

    local hits = {}
    local nearestHead

    for i = 1, math.min(2, #candidates) do
        local target = candidates[i]
        hits[#hits + 1] = {target.mob, target.head}

        if i == 1 then
            nearestHead = target.head
        end
    end

    if nearestHead and #hits > 0 then
        pcall(function()
            AttackRemote:FireServer(1e-9)
            HitRemote:FireServer(nearestHead, hits)
        end)
    end
end

