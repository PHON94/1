local CharacterState

local function CaptureCharacterState()
    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not c or not hum or not root then return end

    CharacterState = {
        humanoid = hum,
        root = root,
        WalkSpeed = hum.WalkSpeed,
        JumpPower = hum.JumpPower,
        AutoRotate = hum.AutoRotate,
        UseJumpPower = hum.UseJumpPower,
        RootCanCollide = root.CanCollide,
        RootAnchored = root.Anchored,
        RootAssemblyLinearVelocity = root.AssemblyLinearVelocity,
        RootAssemblyAngularVelocity = root.AssemblyAngularVelocity,
    }
end

local function RestoreCharacterState()
    local state = CharacterState
    CharacterState = nil

    if not state then return end

    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local root = c and c:FindFirstChild("HumanoidRootPart")

    -- Restore only if this is still the same character/root that was captured.
    if hum and state.humanoid == hum then
        pcall(function() hum.WalkSpeed = state.WalkSpeed end)
        pcall(function() hum.JumpPower = state.JumpPower end)
        pcall(function() hum.AutoRotate = state.AutoRotate end)
        pcall(function() hum.UseJumpPower = state.UseJumpPower end)
    end

    if root and state.root == root then
        pcall(function() root.CanCollide = state.RootCanCollide end)
        pcall(function() root.Anchored = state.RootAnchored end)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local NoGravityAttachment
local NoGravityForce

local function SetNoGravity(enabled)
    local c = LocalPlayer.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")

    if enabled and root then
        if not NoGravityAttachment or NoGravityAttachment.Parent ~= root then
            if NoGravityAttachment then
                pcall(function() NoGravityAttachment:Destroy() end)
            end
            NoGravityAttachment = Instance.new("Attachment")
            NoGravityAttachment.Name = "Phongdz_NoGravity"
            NoGravityAttachment.Parent = root
        end

        if not NoGravityForce or NoGravityForce.Parent ~= root then
            if NoGravityForce then
                pcall(function() NoGravityForce:Destroy() end)
            end
            NoGravityForce = Instance.new("VectorForce")
            NoGravityForce.Name = "Phongdz_NoGravityForce"
            NoGravityForce.Attachment0 = NoGravityAttachment
            NoGravityForce.RelativeTo = Enum.ActuatorRelativeTo.World
            NoGravityForce.ApplyAtCenterOfMass = true
            NoGravityForce.Parent = root
        end

        NoGravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
    else
        if NoGravityForce then
            pcall(function() NoGravityForce:Destroy() end)
            NoGravityForce = nil
        end
        if NoGravityAttachment then
            pcall(function() NoGravityAttachment:Destroy() end)
            NoGravityAttachment = nil
        end
    end
end

