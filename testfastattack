local function ScrollFunctions(page, delta)
    if not page then return end
    local maxY = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)

    page.CanvasPosition = Vector2.new(
        0,
        math.clamp(page.CanvasPosition.Y + (delta or 0), 0, maxY)
    )
end

local function ScrollFunctionsTop(page)
    if page then
        page.CanvasPosition = Vector2.new(0, 0)
    end
end

local function ScrollFunctionsBottom(page)
    if page then
        page.CanvasPosition = Vector2.new(
            0,
            math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)
        )
    end
end

