local function sourceTimeZone()
    local date = os.date("*t")
    local hour = date.hour % 24
    local ampm = hour < 12 and "AM" or "PM"
    local clock = string.format("%02i:%02i:%02i %s", ((hour - 1) % 12) + 1, date.min, date.sec, ampm)
    local datetime = string.format("%02d/%02d/%04d", date.day, date.month, date.year)

    local code = "Unknown"
    pcall(function()
        local cached = getgenv().countryRegionCode
        if cached then
            code = cached
        else
            local LocalizationService = game:GetService("LocalizationService")
            local result, region = pcall(function()
                return LocalizationService:GetCountryRegionForPlayerAsync(LocalPlayer)
            end)
            if result and region then
                code = region
                getgenv().countryRegionCode = region
            end
        end
    end)

    return datetime .. " - " .. clock .. " [ " .. code .. " ]"
end

local function sourceGameTime()
    local total = math.floor(workspace.DistributedGameTime + 0.5)
    local hour = math.floor(total / 3600) % 24
    local minute = math.floor(total / 60) % 60
    local second = total % 60
    return hour .. " Hour (h) " .. minute .. " Minute (m) " .. second .. " Second (s)"
end

local function sourceBoneCount()
    local value = 0
    pcall(function()
        local main = LocalPlayer:FindFirstChild("Data")
        local fragments = main and main:FindFirstChild("Fragments")
        -- Source's UI reads the "Bone" value from the player Data when available.
        local bone = main and main:FindFirstChild("Bone")
        if bone and typeof(bone.Value) == "number" then
            value = bone.Value
        elseif fragments and typeof(fragments.Value) == "number" then
            -- Do not invent a Bone value when the source's exact value is absent.
            value = 0
        end
    end)
    return tostring(value)
end

local function statusText(exists)
    return exists and "Status: ✅" or "Status: ❌"
end

