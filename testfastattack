            return best
        end

        local function sameTarget(targetCF)
            return ResetBypass.LastTarget
                and (targetCF.Position - ResetBypass.LastTarget.Position).Magnitude
                    <= ResetBypass.Tolerance
        end

        local function execute(targetCF)
            if not ResetBypass.Enabled
                or ResetBypass.Busy
                or not targetCF then
                return false
            end

            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if not character or not humanoid or not root or humanoid.Health <= 0 then
                return false
            end

            local currentDistance = (targetCF.Position - root.Position).Magnitude
            if currentDistance <= 3500 then
                return false
            end

            -- Multi-hop source behavior: the same destination is allowed to
            -- trigger another reset while it is still a long distance away.
            -- This is what lets the player respawn at an intermediate island,
            -- recalculate the distance, and then take another reset hop.
            if sameTarget(targetCF)
                and os.clock() - ResetBypass.LastUse < ResetBypass.Cooldown then
                return false
            end

            if os.clock() - ResetBypass.LastUse < ResetBypass.Cooldown then
                return false
            end

            local spawn = getSpawnForTarget(targetCF)
            local spawnPart = spawn and spawn:FindFirstChild("Part")
            if not spawn or not spawnPart then
                return false
            end

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if not commF then
                return false
            end

            ResetBypass.Busy = true
            ResetBypass.LastUse = os.clock()
            ResetBypass.LastTarget = targetCF

            local success = pcall(function()
                local lastSpawnPoint = character:FindFirstChild("LastSpawnPoint")
                if lastSpawnPoint then
                    lastSpawnPoint.Disabled = true
                end

                commF:InvokeServer("SetLastSpawnPoint", spawn.Name)
                commF:InvokeServer("SetSpawnPoint")

                character:PivotTo(spawnPart.CFrame)
                humanoid:ChangeState(15)
            end)

            task.delay(8, function()
                ResetBypass.Busy = false
                -- Release the target lock after the respawn cycle so the
                -- source can choose another intermediate spawn if the same
                -- destination is still farther than the long-distance limit.
                ResetBypass.LastTarget = nil
            end)

            return success
        end

        -- Public bridge for the existing Setting UI.
        _G.PhongdzResetBypass = {
            SetEnabled = function(value)
                ResetBypass.Enabled = value == true

                if not ResetBypass.Enabled then
                    ResetBypass.Busy = false
                    ResetBypass.LastTarget = nil
                end
            end,

            Execute = execute,

            IsEnabled = function()
                return ResetBypass.Enabled
            end
        }

        --========================================================================
        -- SETTING UI
        --========================================================================

        if not settingPage or not settingPage.Parent then
            error("settingPage is unavailable")
        end

        local card = Instance.new("Frame")
        card.Name = "ResetBypassCard"
        card.Size = UDim2.new(1, -8, 0, 62)
        card.BackgroundColor3 = Color3.fromRGB(22, 25, 33)
        card.BorderSizePixel = 0
        card.ZIndex = 80
        card.Parent = settingPage

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = card

        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -12, 1, -12)
        button.Position = UDim2.fromOffset(6, 6)
        button.BackgroundColor3 = Color3.fromRGB(48, 52, 63)
        button.BorderSizePixel = 0
        button.Text = "RESET BYPASS  •  OFF"
        button.Font = Enum.Font.GothamBlack
        button.TextSize = 9
        button.TextColor3 = Color3.fromRGB(225, 228, 235)
        button.AutoButtonColor = false
        button.ZIndex = 81
        button.Parent = card

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 8)
        bc.Parent = button

        local function update()
            if ResetBypass.Enabled then
                button.Text = "RESET BYPASS  •  ON"
                button.BackgroundColor3 = Color3.fromRGB(255, 211, 65)
                button.TextColor3 = Color3.fromRGB(16, 18, 24)
            else
                button.Text = "RESET BYPASS  •  OFF"
                button.BackgroundColor3 = Color3.fromRGB(48, 52, 63)
                button.TextColor3 = Color3.fromRGB(225, 228, 235)
            end
        end

        button.Activated:Connect(function()
            ResetBypass.Enabled = not ResetBypass.Enabled
            _G.PhongdzResetBypass.SetEnabled(ResetBypass.Enabled)
            update()
        end)

        update()

    end, debug.traceback)

    if not ok then
        warn("[PhongdzHub][ResetBypass] Disabled safely:", err)
    end
end)

