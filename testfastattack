local function EquipSelectedMasteryWeapon()
    if SelectedMasteryWeapon == "" then return false end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not humanoid or not backpack then return false end

    local equipped = character:FindFirstChild(SelectedMasteryWeapon)
    if equipped and equipped:IsA("Tool") then return true end

    local tool = backpack:FindFirstChild(SelectedMasteryWeapon)
    if tool and tool:IsA("Tool") then
        pcall(function()
            humanoid:EquipTool(tool)
        end)
        return character:FindFirstChild(SelectedMasteryWeapon) ~= nil
