local function GetSelectedWeaponTool(weaponType)
    if not weaponType then return nil end

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == weaponType then
                return tool
            end
        end
    end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == weaponType then
                return tool
            end
        end
    end

    return nil
end

weaponSc = function(weapon)
    if not _G.AutoLevel or not weapon then return nil end

    local tool = GetSelectedWeaponTool(weapon)
    if not tool then return nil end

    _G.SelectWeapon = tool.Name
    SelectWeapon = tool.Name

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if character and humanoid then
        if tool.Parent == character then
            return tool.Name
        end

        if backpack and tool.Parent == backpack then
            pcall(function()
                humanoid:EquipTool(tool)
            end)

            local equipped = character:FindFirstChild(tool.Name)
            if equipped and equipped:IsA("Tool") and equipped.ToolTip == weapon then
                _G.SelectWeapon = equipped.Name
                SelectWeapon = equipped.Name
                return equipped.Name
            end

            return tool.Name
        end
    end

    return tool.Name
end

