local function RunSourceMasteryStep()
    if not _G.PhongdzMasteryEnabled or not _G.AutoLevel then
        return
    end

    local data = MasteryTargetData[(_G.PhongdzMasteryIsland or "Bone")]
    if not data then return end

    local target = FindMasteryTarget(data)
    if not target then
        ActiveTarget = nil
        TweenTo(data.Position)
        return
    end

    local root = target:FindFirstChild("HumanoidRootPart")
    local humanoid = target:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    ActiveTarget = target
    AutoHaki()
    BringEnemy(target)

    local weaponType = GetSelectedMasteryType()
    if not weaponType then
        EquipSelectedMasteryWeapon()
        weaponType = GetSelectedMasteryType()
    end

    if weaponType == "Sword" then
        -- Source Attack.Sword: bring mob, equip sword, stay above target.
        EquipSelectedMasteryWeapon()
        TweenTo(root.CFrame * CFrame.new(0, 30, 0))
    elseif weaponType == "Gun" then
        -- Source Attack.Masgun: use the low-health window for gun skills.
        local healthThreshold = humanoid.MaxHealth * 0.70
        if humanoid.Health <= healthThreshold then
            EquipSelectedMasteryWeapon()
            TweenTo(root.CFrame * CFrame.new(0, 35, 8))
        else
            -- Source first brings the target down before switching to gun damage.
            local masteryCharacter = LocalPlayer.Character
            local melee = masteryCharacter and masteryCharacter:FindFirstChildOfClass("Tool")
            if not melee or melee.ToolTip ~= "Melee" then
                pcall(EquipFarmWeapon)
            end
            TweenTo(root.CFrame * CFrame.new(0, 30, 0))
        end
    end

    -- Keep the existing source-derived fast attack core active for the
    -- selected Sword/Gun while the mastery routine owns the target.
    if weaponType == "Sword" or weaponType == "Gun" then
        pcall(ExecuteSourceFastAttack)
        pcall(ExecuteSourceHitRegistration)
    end
end

