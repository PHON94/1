local function setPrediction(colorName, conf, statusText)
	PP_Color.Text = colorName
	PP_Color.TextColor3 = COLORS[colorName] or Color3.new(1, 1, 1)
	PP_Question.Visible = false
	PP_Dot.Visible = true 
	PP_Box.BackgroundColor3 = COLORS[colorName] or Color3.fromRGB(42, 36, 54)
	PP_Conf.Text = tostring(conf) .. "%"
	PP_Status.Text = statusText
	PP_Status.TextColor3 = Color3.fromRGB(120, 120, 130)
	local c = Color3.fromRGB(110, 220, 145)
	if conf >= 70 then c = Color3.fromRGB(110, 220, 145)
	elseif conf >= 50 then c = Color3.fromRGB(220, 200, 100)
	else c = Color3.fromRGB(220, 110, 110) end
	PP_Conf.TextColor3 = c
	PP_BarFill.BackgroundColor3 = c
	PP_BarFill.Size = UDim2.new(0, 0, 1, 0)
	TweenService:Create(PP_BarFill, TweenInfo.new(0.4), {Size = UDim2.new(conf / 100, 0, 1, 0)}):Play()
	
	TweenService:Create(PP_Box, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Size = UDim2.new(0, 56, 0, 56)}):Play()
	task.delay(0.2, function()
		TweenService:Create(PP_Box, TweenInfo.new(0.2), {Size = UDim2.new(0, 52, 0, 52)}):Play()
	end)
end

local function resetPrediction()
	PP_Color.Text = "—"
	PP_Color.TextColor3 = Color3.fromRGB(255, 255, 255)
	PP_Question.Visible = true
	PP_Dot.Visible = false 
	PP_Box.BackgroundColor3 = Color3.fromRGB(42, 36, 54)
	PP_Conf.Text = ""
	PP_Status.Text = "Waiting for next roll"
	PP_Status.TextColor3 = Color3.fromRGB(120, 120, 130)
	PP_BarFill.Size = UDim2.new(0, 0, 1, 0)
end

local function updateHitRate()
	local total = hits + misses
	if total == 0 then
		HR_Value.Text = "—"
		HR_Sub.Text = "No results yet"
		HR_BarFill.Size = UDim2.new(0.5, 0, 1, 0)
		return
	end
	local rate = hits / total
	HR_Value.Text = string.format("%.1f%%", rate * 100)
	HR_Sub.Text = string.format("%d / %d hits • streak %d", hits, total, streak)
	TweenService:Create(HR_BarFill, TweenInfo.new(0.4), {Size = UDim2.new(rate, 0, 1, 0)}):Play()
	local col = Color3.fromRGB(110, 220, 145)
	if rate < 0.4 then col = Color3.fromRGB(220, 110, 110)
	elseif rate < 0.55 then col = Color3.fromRGB(220, 200, 100) end
	HR_BarFill.BackgroundColor3 = col
	HR_Value.TextColor3 = col
end

