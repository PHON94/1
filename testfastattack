    if not _G.AutoLevel or _G.AutoMaterial or _G.PhongdzMasteryEnabled or (_G.PhongdzFarmMethod or "Level Farm") ~= "Farm Bones" then
        BoneFarmAlive = false
        BoneFarmTarget = nil
        return
    end

    BoneFarmAlive = true
    local player = LocalPlayer
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local questUI = player.PlayerGui
        and player.PlayerGui:FindFirstChild("Main")
        and player.PlayerGui.Main:FindFirstChild("Quest")

    -- Source Bone quest location/quest variants.
    if questUI and not questUI.Visible then
        local questPos = CFrame.new(-9516.99316,172.01718,6078.46533)
