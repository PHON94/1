local function sourceMoonTexture()
    local lighting = game:GetService("Lighting")
    local placeId = game.PlaceId

    local world1 = placeId == 2753915549 or placeId == 85211729168715
    local world2 = placeId == 4442272183 or placeId == 79091703265657
    local world3 = placeId == 7449423635 or placeId == 100117331123089

    if world1 or world2 then
        local sky = lighting:FindFirstChild("FantasySky")
        return sky and sky.MoonTextureId or ""
    elseif world3 then
        local sky = lighting:FindFirstChild("Sky")
        return sky and sky.MoonTextureId or ""
    end

    local sky = lighting:FindFirstChild("Sky") or lighting:FindFirstChild("FantasySky")
    return sky and sky.MoonTextureId or ""
end

