for _, page in pairs(CategoryPages) do
    page.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            ScrollFunctions(page, -(input.Position.Z or 0) * 42)
        end
    end)

    local touching = false
    local touchStart = 0
    local scrollStart = 0

    page.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            touching = true
            touchStart = input.Position.Y
            scrollStart = page.CanvasPosition.Y
        end
    end)

    page.InputChanged:Connect(function(input)
        if not touching or input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local dy = input.Position.Y - touchStart
        local maxY = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)

        page.CanvasPosition = Vector2.new(
            0,
            math.clamp(scrollStart - dy, 0, maxY)
        )
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            touching = false
        end
    end)
end


