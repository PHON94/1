local function putFolder(guiObject, x, y)
    guiObject.Parent = FolderScroll
    guiObject.Position = UDim2.fromOffset(x, y)
end

-- Mouse-wheel scrolling.
UIS.InputChanged:Connect(function(input)
    if not Main.Visible or not FolderScroll.Visible then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseWheel then
        local delta = input.Position.Z
        local target = FolderScroll.CanvasPosition.Y - delta * 42
        local maxY = math.max(0, FolderScroll.AbsoluteCanvasSize.Y - FolderScroll.AbsoluteWindowSize.Y)
        FolderScroll.CanvasPosition = Vector2.new(
            0,
            math.clamp(target, 0, maxY)
        )
    end
end)

-- Touch swipe with a little momentum.
local swipeActive = false
local swipeStartY = 0
local swipeStartScroll = 0
local lastTouchY = 0
local lastTouchTime = 0

FolderScroll.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        swipeActive = true
        swipeStartY = input.Position.Y
        swipeStartScroll = FolderScroll.CanvasPosition.Y
        lastTouchY = input.Position.Y
        lastTouchTime = os.clock()
    end
end)

FolderScroll.InputChanged:Connect(function(input)
    if not swipeActive or input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local y = input.Position.Y
    local dy = y - swipeStartY
    FolderScroll.CanvasPosition = Vector2.new(0, swipeStartScroll - dy)

    lastTouchY = y
    lastTouchTime = os.clock()
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if not swipeActive then
        return
    end

    swipeActive = false

    -- Clamp after the swipe.
    local maxY = math.max(0, FolderScroll.AbsoluteCanvasSize.Y - FolderScroll.AbsoluteWindowSize.Y)
    FolderScroll.CanvasPosition = Vector2.new(
        0,
        math.clamp(FolderScroll.CanvasPosition.Y, 0, maxY)
    )
end)

-- Convenience controls for scripts/folders.
local function scrollFoldersToTop()
    FolderScroll.CanvasPosition = Vector2.new(0, 0)
end

local function scrollFoldersToBottom()
    local maxY = math.max(0, FolderScroll.AbsoluteCanvasSize.Y - FolderScroll.AbsoluteWindowSize.Y)
    FolderScroll.CanvasPosition = Vector2.new(0, maxY)
end

