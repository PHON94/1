local function GetMasteryInventory()
    local result = {}
    local seen = {}

    local function addTool(name, weaponType, mastery)
        if not name or name == "" or seen[name] then return end
        seen[name] = true
        result[#result + 1] = {
            Name = name,
            Type = weaponType or "Weapon",
            Mastery = tonumber(mastery) or 0,
        }
    end

    local ok, inventory = pcall(function()
        return ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")
    end)

    if ok and type(inventory) == "table" then
        for _, item in pairs(inventory) do
            if type(item) == "table" and
                (item.Type == "Sword" or item.Type == "Gun") then
                addTool(item.Name, item.Type, item.Mastery)
            end
        end
    end

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    local function scan(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local tooltip = tool.ToolTip
                if tooltip == "Sword" or tooltip == "Gun" then
                    addTool(tool.Name, tooltip, tool:GetAttribute("Mastery"))
                end
            end
        end
    end

    scan(backpack)
    scan(character)

    table.sort(result, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    return result
end

