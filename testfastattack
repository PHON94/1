local function refreshWeaponList()
    for _, child in ipairs(WeaponList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local names = {"Auto"}
    local seen = {Auto = true}

    local function scan(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(names, item.Name)
            end
        end
    end

    scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
    scan(LocalPlayer.Character)

    table.sort(names, function(a, b)
        if a == "Auto" then return true end
        if b == "Auto" then return false end
        return a:lower() < b:lower()
    end)

    for _, weaponName in ipairs(names) do
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -8, 0, 31)
        button.Text = weaponName
        button.Font = Enum.Font.GothamMedium
        button.TextSize = 9
        button.TextColor3 = Color3.fromRGB(220, 223, 230)
        button.BackgroundColor3 = Color3.fromRGB(39, 43, 52)
        button.BorderSizePixel = 0
        button.AutoButtonColor = false
        button.Parent = WeaponList

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 6)
        bc.Parent = button

        button.Activated:Connect(function()
            _G.FarmWeapon = weaponName
            WeaponDropdown.Text = "Vũ khí: " .. weaponName
            WeaponList.Visible = false
        end)
    end

    WeaponList.CanvasSize = UDim2.fromOffset(0, weaponLayout.AbsoluteContentSize.Y + 6)
end

WeaponDropdown.Activated:Connect(function()
    refreshWeaponList()
    WeaponList.Visible = not WeaponList.Visible
end)

