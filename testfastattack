local function GetSourceFastAttackRemotes()
    if SourceFastAttack.AttackRemote and SourceFastAttack.HitRemote
        and SourceFastAttack.AttackRemote.Parent and SourceFastAttack.HitRemote.Parent then
        return SourceFastAttack.AttackRemote, SourceFastAttack.HitRemote
