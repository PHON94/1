            task.wait()
        until not bone.Parent or not SourceFarmAlive(bone)

        BoneFarmTarget = nil
        ActiveTarget = nil
    else
        TweenTo(CFrame.new(-9495.6806640625, 453.58624267578125, 5977.3486328125))
    end
