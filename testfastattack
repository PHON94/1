local farmLoaded = false
local farmError = nil

local function loadFarm()
    if farmLoaded then
        return true
    end

    local loader = loadstring

    if type(loader) ~= "function" then
        farmError = "loadstring unavailable"
        return false
    end

    local okCompile, chunkOrError = pcall(loader, FARM_SOURCE)

    if not okCompile or type(chunkOrError) ~= "function" then
        farmError = tostring(chunkOrError)
        warn("[PhongdzHub] Farm compile error:", farmError)
        return false
    end

    local okRun, runtimeError = pcall(chunkOrError)

    if not okRun then
        farmError = tostring(runtimeError)
        warn("[PhongdzHub] Farm runtime error:", farmError)
        return false
    end

    farmLoaded = true
    return true
end

local farmEnabled = false

local function updateToggle()
    if farmEnabled then
        Toggle.BackgroundColor3 = Color3.fromRGB(255, 211, 65)
        Knob.Position = UDim2.fromOffset(26, 3)
        Knob.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
        Status.Text = "● FARM LEVEL ĐANG CHẠY"
        Status.TextColor3 = Color3.fromRGB(88, 224, 132)
    else
        Toggle.BackgroundColor3 = Color3.fromRGB(55, 59, 70)
        Knob.Position = UDim2.fromOffset(3, 3)
        Knob.BackgroundColor3 = Color3.fromRGB(230, 232, 238)

        if farmError then
            Status.Text = "● FARM SOURCE ERROR"
            Status.TextColor3 = Color3.fromRGB(255, 95, 95)
        else
            Status.Text = "● MENU READY — FARM OFF"
            Status.TextColor3 = Color3.fromRGB(130, 135, 148)
        end
    end
end

Toggle.Activated:Connect(function()
    farmEnabled = not farmEnabled

    if farmEnabled then
        CaptureCharacterState()
    else
        RestoreAfterFarm()
    end

    _G.AutoLevel = farmEnabled

    if farmEnabled and not farmLoaded then
        if not loadFarm() then
            farmEnabled = false
            _G.AutoLevel = false
            RestoreAfterFarm()
        end
    end

    updateToggle()
end)

-- Keep coordinate-based positioning valid after viewport changes.
local lastViewport = viewport()

RunService.RenderStepped:Connect(function()
    if not Gui.Parent then
        return
    end

    local v = viewport()

    if v.X ~= lastViewport.X or v.Y ~= lastViewport.Y then
        lastViewport = v
        forceXY(X, Y)

        if minimized then
            Launcher.Position = UDim2.fromOffset(
                math.clamp(X + 190, 0, math.max(0, v.X - 58)),
                math.clamp(Y + 96, 0, math.max(0, v.Y - 58))
            )
        end
    end
end)

