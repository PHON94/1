local function setActiveTab(name)
    activeTab = name

    for tabName, button in pairs(tabs) do
        local selected = (tabName == name)
        button.BackgroundColor3 = selected
            and Color3.fromRGB(255, 211, 65)
            or Color3.fromRGB(35, 38, 47)
        button.TextColor3 = selected
            and Color3.fromRGB(16, 18, 24)
            or Color3.fromRGB(190, 194, 204)
    end

    -- Only the Farm tab displays Farm controls.
    local farmVisible = (name == "Farm")
    local settingsVisible = (name == "Settings Farm")

    if Card then Card.Visible = farmVisible end
    if Toggle then Toggle.Visible = farmVisible end
    if BoneCard then BoneCard.Visible = farmVisible end
    if SettingsFrame then
        SettingsFrame.Visible = settingsVisible
        if settingsVisible then
            SettingsFrame.CanvasPosition = Vector2.zero
        end
    end

    if FarmContent then
        FarmContent.Visible = farmVisible
        if farmVisible then
            FarmContent.CanvasPosition = Vector2.zero
        end
    end
end

