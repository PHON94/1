local function pickBestColor()
	if #history == 0 then
		return COLOR_ORDER[math.random(#COLOR_ORDER)], math.random(50, 63)
	end
	-- Fa4e7xx ur dad btw
	local counts, streaks = {}, {}
	for _, c in ipairs(COLOR_ORDER) do counts[c] = 0; streaks[c] = 0 end
	for _, entry in ipairs(history) do
		for i = 1, 4 do if entry.picks[i] then counts[entry.picks[i]] = counts[entry.picks[i]] + 1 end end
	end
	for _, c in ipairs(COLOR_ORDER) do
		for i = #history, 1, -1 do
			local present = false
			for j = 1, 4 do if history[i].picks[j] == c then present = true break end end
			if not present then streaks[c] = streaks[c] + 1 else break end
		end
	end
	
	-- Fa4e7xx ur dad btw
	local bestScore = -math.huge
	local candidates = {}
	for _, c in ipairs(COLOR_ORDER) do
		local score = streaks[c] + 1 / (1 + counts[c]) + math.random()
		if score > bestScore then
			bestScore = score
			candidates = {c}
		elseif math.abs(score - bestScore) < 0.001 then 
			table.insert(candidates, c)
		end
	end
	local best = candidates[math.random(1, #candidates)]
	local conf = math.random(50, 63)
	return best, conf
end

local function doPredict()
	if isCooldownActive then return end

	local picks = {}
	for i = 1, 4 do picks[i] = diceColors[i] end

	local entry = {picks = picks, result = "PENDING", confidence = 0}
	local chosen, conf = pickBestColor()
	table.insert(history, entry)
	rollsObserved = rollsObserved + 1

	entry.prediction = chosen
	entry.confidence = conf
	setPrediction(chosen, conf, string.format("Based on %d rolls", #history))

	local hit = false
	for i = 1, 4 do if picks[i] == chosen then hit = true break end end
	if #history == 1 then hit = true end
	if hit then
		entry.result = "HIT"
		hits = hits + 1
		streak = streak + 1
	else
		entry.result = "MISS"
		misses = misses + 1
		streak = 0
	end

	updateHitRate()
	Footer.Text = string.format("Rolls %d • Next #%d • Bet %d", rollsObserved, rollsObserved + 1, betAmount)
	if HistoryOverlay.Visible then refreshHistoryUI() end

	if not removeExpireCooldown then
		isCooldownActive = true
		CooldownBarBg.Visible = true
		CooldownBarFill.Size = UDim2.new(1, 0, 1, 0)
		CooldownBarFill.BackgroundColor3 = ACCENT_START
		
		TweenService:Create(CooldownBarFill, TweenInfo.new(3, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()
		
		task.spawn(function()
			for i = 3, 1, -1 do
				PP_Status.Text = string.format("Expires in %ds", i)
				PP_Status.TextColor3 = Color3.fromRGB(220, 200, 100)
				task.wait(1)
			end
			isCooldownActive = false
			CooldownBarBg.Visible = false
			resetPrediction()
		end)
	else
		CooldownBarBg.Visible = false
	end
end

