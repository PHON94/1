-- Drag logic
local dragging = false
local dragInput, dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

btn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging and dragStart and startPos then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Helpers toggle Fluent GUI
local function setGuiVisible(gui, visible)
    if not gui then return end
    if gui:IsA("ScreenGui") and gui.Enabled ~= nil then
        gui.Enabled = visible
        return
    end
    for _, v in ipairs(gui:GetDescendants()) do
        if v:IsA("GuiObject") then
            v.Visible = visible
        end
    end
end

local function getGuiVisible(gui)
    if not gui then return true end
    if gui:IsA("ScreenGui") and gui.Enabled ~= nil then
        return gui.Enabled
    end
    for _, v in ipairs(gui:GetDescendants()) do
        if v:IsA("GuiObject") then
            return v.Visible
        end
    end
    return true
end

local fluentGui = findFluentScreenGui()
local function updateLabel()
    if fluentGui and fluentGui.Parent then
        label.Text = (getGuiVisible(fluentGui) == false) and "+" or "-"
    else
        label.Text = "-"
    end
end

btn.MouseButton1Click:Connect(function()
    if not fluentGui or not fluentGui.Parent then
        fluentGui = findFluentScreenGui()
    end
    if fluentGui then
        setGuiVisible(fluentGui, not getGuiVisible(fluentGui))
        updateLabel()
    else
        warn("[Minimizer] Không tìm thấy Fluent ScreenGui. Đảm bảo Fluent đã tạo GUI trước khi minimizer chạy.")
    end
end)

spawn(function()
    local attempts = 0
    while attempts < 10 and (not fluentGui) do
        fluentGui = findFluentScreenGui()
        if fluentGui then break end
        attempts = attempts + 1
        wait(0.5)
    end
    updateLabel()
end)

