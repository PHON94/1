-- ======================
-- Minimizer auto-bind (ưu tiên dùng Window methods/fields)
-- ======================
do
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = nil
    pcall(function() PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 3) end)
    local parentGui = PlayerGui or game:GetService("CoreGui")

    local minimizerGui = Instance.new("ScreenGui")
    minimizerGui.Name = "BFP_Minimizer_Auto"
    minimizerGui.ResetOnSpawn = false
    minimizerGui.DisplayOrder = 9999
    minimizerGui.Parent = parentGui

    local btn = Instance.new("ImageButton")
    btn.Name = "MinimizeButton"
    btn.Parent = minimizerGui
    btn.Size = UDim2.new(0, 48, 0, 48)
    btn.Position = UDim2.new(0, 10, 0, 120)
    btn.AnchorPoint = Vector2.new(0,0)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = true
    btn.Image = ""
    btn.Visible = true

    local corner = Instance.new("UICorner", btn); corner.CornerRadius = UDim.new(1,0)
    local label = Instance.new("TextLabel", btn)
    label.Size = UDim2.new(1,0,1,0); label.BackgroundTransparency = 1
    label.Text = "-"; label.TextScaled = true; label.Font = Enum.Font.SourceSansSemibold

    -- drag
    local dragging=false; local dragInput, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=btn.Position
            input.Changed:Connect(function()
                if input.UserInputState==Enum.UserInputState.End then dragging=false end
            end)
        end
    end)
    btn.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
    UIS.InputChanged:Connect(function(input)
        if input==dragInput and dragging and dragStart and startPos then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local function setGuiVisible(gui, visible)
        if not gui then return end
        if gui:IsA("ScreenGui") and gui.Enabled ~= nil then gui.Enabled = visible; return end
        for _,v in ipairs(gui:GetDescendants()) do if v:IsA("GuiObject") then v.Visible = visible end end
    end
    local function getGuiVisible(gui)
        if not gui then return true end
        if gui:IsA("ScreenGui") and gui.Enabled ~= nil then return gui.Enabled end
        for _,v in ipairs(gui:GetDescendants()) do if v:IsA("GuiObject") then return v.Visible end end
        return true
    end

    -- Detect accessor from Window
    local fluentAccessor = nil
    if Window then
        for _,m in ipairs({"Toggle","ToggleVisibility","Minimize","Hide","Show","SetVisible","SetEnabled","Close"}) do
            if type(Window[m]) == "function" then
                fluentAccessor = { mode = "method", name = m, fn = Window[m] }
                break
            end
        end
        if not fluentAccessor then
            for _,f in ipairs({"Root","Main","Frame","ScreenGui","Container","Window","Gui","UI","RootGui"}) do
                local ok, val = pcall(function() return Window[f] end)
                if ok and typeof(val) == "Instance" and val:IsA("GuiObject") then
                    fluentAccessor = { mode = "gui", gui = val }
                    break
                end
            end
        end
        if not fluentAccessor then
            for k,v in pairs(Window) do
                if typeof(v) == "Instance" and v:IsA("GuiObject") then
                    fluentAccessor = { mode = "gui", gui = v }
                    break
                end
            end
        end
    end

    local function findFluentScreenGuiBySearch()
        local targets = { PlayerGui, game:GetService("CoreGui") }
        local patterns = { "Blox Fruit Premium Menu", "Bản Sạch", "Blox Fruit" }
        for _, parent in ipairs(targets) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") then
                        for _, d in ipairs(child:GetDescendants()) do
                            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text and d.Text ~= "" then
                                for _, p in ipairs(patterns) do
                                    if tostring(d.Text):match(p) then return child end
                                end
                            end
                        end
                    end
                end
            end
        end
        for _, parent in ipairs(targets) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") and #child:GetDescendants() > 10 then return child end
                end
            end
        end
        return nil
    end

    btn.MouseButton1Click:Connect(function()
        -- refresh detection if needed
        if not fluentAccessor then
            if Window then
                for _,m in ipairs({"Toggle","ToggleVisibility","Minimize","Hide","Show","SetVisible","SetEnabled","Close"}) do
                    if type(Window[m]) == "function" then fluentAccessor={mode="method",name=m,fn=Window[m]}; break end
                end
                if not fluentAccessor then
                    for _,f in ipairs({"Root","Main","Frame","ScreenGui","Container","Window","Gui","UI","RootGui"}) do
                        local ok,val = pcall(function() return Window[f] end)
                        if ok and typeof(val)=="Instance" and val:IsA("GuiObject") then fluentAccessor={mode="gui",gui=val}; break end
                    end
                end
                if not fluentAccessor then
                    for k,v in pairs(Window) do if typeof(v)=="Instance" and v:IsA("GuiObject") then fluentAccessor={mode="gui",gui=v}; break end end
                end
            end
            if not fluentAccessor then
                local found = findFluentScreenGuiBySearch()
                if found then fluentAccessor = { mode="gui", gui=found } end
            end
        end

        if fluentAccessor then
            if fluentAccessor.mode == "method" then
                local ok, err = pcall(function() fluentAccessor.fn(Window) end)
                if not ok then pcall(function() fluentAccessor.fn() end) end
                wait(0.05)
                -- try resolve GUI after method call
                if not fluentAccessor.gui then
                    local found = findFluentScreenGuiBySearch()
                    if found then fluentAccessor = { mode="gui", gui=found } end
                end
            else
                local g = fluentAccessor.gui
                if g and g.Parent then
                    setGuiVisible(g, not getGuiVisible(g))
                else
                    local found = findFluentScreenGuiBySearch()
                    if found then fluentAccessor = { mode="gui", gui=found }; setGuiVisible(found, not getGuiVisible(found)) else
                        if fallbackGui then fallbackGui.Enabled = not fallbackGui.Enabled; label.Text = (fallbackGui.Enabled==false) and "+" or "-" else
                            warn("[Minimizer] Không tìm thấy Fluent GUI để toggle.")
                        end
                    end
                end
            end
        else
            -- fallback
            local found = findFluentScreenGuiBySearch()
            if found then setGuiVisible(found, not getGuiVisible(found)) else
                if fallbackGui then fallbackGui.Enabled = not fallbackGui.Enabled; label.Text = (fallbackGui.Enabled==false) and "+" or "-" else
                    warn("[Minimizer] Không tìm thấy Fluent Window/GUI và không có fallback.")
                end
            end
        end

        -- update label
        if fluentAccessor and fluentAccessor.mode=="gui" and fluentAccessor.gui then
            label.Text = (getGuiVisible(fluentAccessor.gui) == false) and "+" or "-"
        else
            if fallbackGui then label.Text = (fallbackGui.Enabled==false) and "+" or "-" end
        end
    end)

    -- initial label detect
    if fluentAccessor and fluentAccessor.mode=="gui" and fluentAccessor.gui then
        label.Text = (getGuiVisible(fluentAccessor.gui)==false) and "+" or "-"
    end
end

