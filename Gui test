local function isTableEmpty(t) return (type(t) ~= "table") or (next(t) == nil) end

-- ======================
-- INSPECT Window (in ra console để debug)
-- ======================
do
    print("=== Window inspection start ===")
    for k,v in pairs(Window) do
        local ok, ty = pcall(function() return typeof(v) end)
        if ok and ty == "Instance" then
            print(k, "=> Instance:", v.ClassName, "Name:", v.Name)
        else
            print(k, "=>", type(v), (type(v) == "function" and "(function)" or tostring(v)))
        end
    end
    -- In thêm các field có kiểu Instance
    for k,v in pairs(Window) do
        local ok, ty = pcall(function() return typeof(v) end)
        if ok and ty == "Instance" then
            print("Found Instance field:", k, "Class:", v.ClassName, "Name:", v.Name)
        end
    end
    print("=== Window inspection end ===")
end

-- ======================
-- Farming UI: dùng Fluent nếu có, else fallback panel
-- ======================
local usedFluentControls = false

do
    local okMulti = type(Tabs.Farming.AddMultiDropdown) == "function"
    local okToggle = type(Tabs.Farming.AddToggle) == "function"
    if okMulti and okToggle then
        usedFluentControls = true
        Tabs.Farming:AddMultiDropdown("MultiDropdownFarm", {
            Title = "Chọn kiểu farm cần làm",
            Values = {"Farm Level", "Farm Bones"},
            Default = {},
            Callback = function(Value)
                if type(Value) == "table" then _G.DanhSachFarmDaChon = Value else _G.DanhSachFarmDaChon = {} end
                local s = ""
                if not isTableEmpty(_G.DanhSachFarmDaChon) then
                    for i,v in ipairs(_G.DanhSachFarmDaChon) do s = s .. (i==1 and "" or ", ") .. tostring(v) end
                end
                print("[Farm] Selected:", (s=="" and "<none>" or s))
            end
        })

        Tabs.Farming:AddToggle("StartFarmToggle", {
            Title = "Start Farm",
            Default = false,
            Callback = function(Value)
                if Value then
                    if isTableEmpty(_G.DanhSachFarmDaChon) then
                        warn("Chưa chọn mục farm nào. Vui lòng chọn trước khi bật.")
                        _G.IsStartFarm = false
                        return
                    end
                    _G.IsStartFarm = true
                    print("[Farm] Bắt đầu farm:", table.concat(_G.DanhSachFarmDaChon, ", "))
                else
                    _G.IsStartFarm = false
                    print("[Farm] Dừng farm.")
                end
            end
        })
    end
end

