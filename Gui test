-- Khởi tạo thư viện trực tiếp từ nguồn tải chính thức của Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- Đăng ký các biến cấu hình toàn cục lên bộ nhớ hệ thống
_G.DanhSachFarmDaChon = {}
_G.IsStartFarm = false

-- Cấu hình khung cửa sổ hiển thị trực quan
local Window = Fluent:CreateWindow({
    Title = "Blox Fruit Premium Menu",
    SubTitle = "Bản Sạch Không Lỗi Console",
    TabWidth = 170, 
    Size = UDim2.fromOffset(590, 470),
    Acrylic = false, -- Tắt hiệu ứng mờ nâng cao để tối ưu tốc độ phản hồi của Executor
    Theme = "Dark", 
    MinimizeKey = Enum.KeyCode.RightControl -- Phím ẩn/hiện menu mặc định là nút Ctrl bên phải
})

-- Thiết lập danh sách các tab chức năng ở cột trái
local Tabs = {
    Shop = Window:AddTab({ Title = "Shop", Icon = "shopping-cart" }),
    Status = Window:AddTab({ Title = "Status", Icon = "user" }),
    SettingFarm = Window:AddTab({ Title = "Setting Farm", Icon = "settings" }),
    Farming = Window:AddTab({ Title = "Farming", Icon = "swords" }),
    StackFarm = Window:AddTab({ Title = "Stack Farm", Icon = "layers" }),
    FarmingOther = Window:AddTab({ Title = "Farming Other", Icon = "plus-circle" }),
    V4AndRace = Window:AddTab({ Title = "V4 and Race", Icon = "shield" })
}

-- Chèn các nút bấm tương tác trống vào bên trong danh mục Farming
Tabs.Farming:AddParagraph({ Title = "Hệ Thống Tự Động Farm", Content = "Tích chọn các mục muốn chạy rồi nhấn Start Farm." })

Tabs.Farming:AddMultiDropdown("MultiDropdownFarm", {
    Title = "Chọn kiểu farm cần làm",
    Values = {"Farm Level", "Farm Bones"},
    Default = {},
    Callback = function(Value)
        _G.DanhSachFarmDaChon = Value 
    end
})

Tabs.Farming:AddToggle("StartFarmToggle", {
    Title = "Start Farm",
    Default = false,
    Callback = function(Value)
        _G.IsStartFarm = Value 
    end
})

-- Ép menu tự động hiển thị tab đầu tiên ngay khi kích hoạt xong
Window:SelectTab(1)
