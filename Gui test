    switch.TextColor3 = Color3.fromRGB(255,255,255)
    switch.Font = Enum.Font.SourceSansSemibold
    switch.TextSize = 14
    local swCorner = Instance.new("UICorner", switch)
    swCorner.CornerRadius = UDim.new(0,6)

    -- Small warning label
    local warnLabel = Instance.new("TextLabel", frame)
    warnLabel.Name = "WarnLabel"
    warnLabel.Size = UDim2.new(1, -20, 0, 20)
    warnLabel.Position = UDim2.new(0, 10, 1, -20)
    warnLabel.BackgroundTransparency = 1
    warnLabel.Text = ""
    warnLabel.TextColor3 = Color3.fromRGB(255,100,100)
    warnLabel.Font = Enum.Font.SourceSans
    warnLabel.TextSize = 14
    warnLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- State
    local selected = { ["Farm Level"] = false, ["Farm Bones"] = false }

    local function updateGlobalSelected()
        local t = {}
        for k,v in pairs(selected) do
            if v then table.insert(t, k) end
        end
        _G.DanhSachFarmDaChon = t
    end

    local function updateCheckboxVisual(btnObj, checked)
        if checked then
            btnObj.Text = "   [x] " .. (btnObj == cb1 and "Farm Level" or "Farm Bones")
            btnObj.BackgroundColor3 = Color3.fromRGB(60, 100, 60)
        else
            btnObj.Text = "   [ ] " .. (btnObj == cb1 and "Farm Level" or "Farm Bones")
            btnObj.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end
    end

    cb1.MouseButton1Click:Connect(function()
        selected["Farm Level"] = not selected["Farm Level"]
        updateCheckboxVisual(cb1, selected["Farm Level"])
        updateGlobalSelected()
        warnLabel.Text = ""
    end)

    cb2.MouseButton1Click:Connect(function()
        selected["Farm Bones"] = not selected["Farm Bones"]
        updateCheckboxVisual(cb2, selected["Farm Bones"])
        updateGlobalSelected()
        warnLabel.Text = ""
    end)

    -- Start/Stop logic
    local function setSwitchState(on)
        _G.IsStartFarm = on
        if on then
            switch.Text = "Start: ON"
            switch.BackgroundColor3 = Color3.fromRGB(60,160,60)
            warnLabel.Text = ""
            print("[Farm] Bắt đầu farm:", table.concat(_G.DanhSachFarmDaChon, ", "))
        else
            switch.Text = "Start: OFF"
            switch.BackgroundColor3 = Color3.fromRGB(70,70,70)
            warnLabel.Text = ""
            print("[Farm] Dừng farm.")
        end
    end

    switch.MouseButton1Click:Connect(function()
        if not next(_G.DanhSachFarmDaChon) then
            -- show warning and don't turn on
            warnLabel.Text = "Vui lòng chọn ít nhất 1 mục farm trước khi bật."
            -- briefly flash red/back
            spawn(function()
                local orig = switch.BackgroundColor3
                switch.BackgroundColor3 = Color3.fromRGB(160,60,60)
                wait(0.25)
                switch.BackgroundColor3 = orig
            end)
            setSwitchState(false)
            return
        end
        setSwitchState(not _G.IsStartFarm)
    end)

    -- Init visuals
    updateCheckboxVisual(cb1, false)
    updateCheckboxVisual(cb2, false)
    setSwitchState(false)
end

