-- Minimizer (keeps same behavior, plus toggles fallback GUI if present)
do
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local PlayerGui
    pcall(function() PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 3) end)
    local parentGui = PlayerGui or game:GetService("CoreGui")

    local minimizerGui = Instance.new("ScreenGui")
    minimizerGui.Name = "BFP_Minimizer"
    minimizerGui.ResetOnSpawn = false
    minimizerGui.DisplayOrder = 9999
    minimizerGui.Parent = parentGui

    local btn = Instance.new("ImageButton")
    btn.Name = "MinimizeButton"
    btn.Parent = minimizerGui
    btn.Size = UDim2.new(0, 48, 0, 48)
    btn.Position = UDim2.new(0, 10, 0, 120)
    btn.AnchorPoint = Vector2.new(0,0)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = true
    btn.Image = ""
    btn.Visible = true

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(1,0)
    local label = Instance.new("TextLabel", btn)
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = "-"
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansSemibold

    local dragging = false
    local dragInput, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging and dragStart and startPos then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- find Fluent ScreenGui (same method as before)
    local function findFluentScreenGui()
        local targets = { PlayerGui, game:GetService("CoreGui") }
        local patterns = { "Blox Fruit Premium Menu", "Bản Sạch", "Blox Fruit" }
        for _, parent in ipairs(targets) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") then
                        for _, d in ipairs(child:GetDescendants()) do
                            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text and d.Text ~= "" then
                                for _, p in ipairs(patterns) do
                                    if tostring(d.Text):match(p) then
                                        return child
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        for _, parent in ipairs(targets) do
            if parent then
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("ScreenGui") and #child:GetDescendants() > 10 then
                        return child
                    end
                end
            end
        end
        return nil
    end

    local fluentGui = findFluentScreenGui()

    local function setGuiVisible(gui, visible)
        if not gui then return end
        if gui:IsA("ScreenGui") and gui.Enabled ~= nil then
            gui.Enabled = visible
            return
        end
        for _, v in ipairs(gui:GetDescendants()) do
            if v:IsA("GuiObject") then v.Visible = visible end
        end
    end

    local function getGuiVisible(gui)
        if not gui then return true end
        if gui:IsA("ScreenGui") and gui.Enabled ~= nil then return gui.Enabled end
        for _, v in ipairs(gui:GetDescendants()) do
            if v:IsA("GuiObject") then return v.Visible end
        end
        return true
    end

    local function updateLabel()
        if fluentGui and fluentGui.Parent then
            label.Text = (getGuiVisible(fluentGui) == false) and "+" or "-"
        else
            label.Text = "-"
        end
    end

    btn.MouseButton1Click:Connect(function()
        if not fluentGui or not fluentGui.Parent then fluentGui = findFluentScreenGui() end
        if fluentGui then
            local vis = not getGuiVisible(fluentGui)
            setGuiVisible(fluentGui, vis)
            -- also toggle fallback if present
            if fallbackGui then fallbackGui.Enabled = vis end
            updateLabel()
        else
            -- if no fluentGui, still toggle fallback if exists
            if fallbackGui then
                fallbackGui.Enabled = not fallbackGui.Enabled
                label.Text = (fallbackGui.Enabled == false) and "+" or "-"
            else
                warn("[Minimizer] Không tìm thấy Fluent ScreenGui và không có fallback.")
            end
        end
    end)

    spawn(function()
        local attempts = 0
        while attempts < 10 and (not fluentGui) do
            fluentGui = findFluentScreenGui()
            if fluentGui then break end
            attempts = attempts + 1
            wait(0.5)
        end
        updateLabel()
    end)
end

