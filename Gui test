-- =============================================================================
-- KIỂM TRA VÀ DỌN DEP MENU CŨ TRÁNH XUNG ĐỘT
-- =============================================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

if PlayerGui then
    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui.Name == "Fluent" or (gui.Name == "ScreenGui" and gui:FindFirstChild("Fluent")) then
            gui:Destroy()
        end
    end
end
task.wait(0.1)

-- =============================================================================
-- KHỞI TẠO MENU FLUENT UI VÀ BẮT BUỘC HIỂN THỊ LÊN LUÔN
-- =============================================================================
local Fluent = loadstring(game:HttpGet("https://github.com"))()

_G.DanhSachFarmDaChon = {}
_G.IsStartFarm = false

local Window = Fluent:CreateWindow({
    Title = "Blox Fruit Premium Menu",
    SubTitle = "Auto Open Mode",
    TabWidth = 170, 
    Size = UDim2.fromOffset(590, 470),
    Acrylic = false, -- Tắt Acrylic kính mờ để menu load nhanh và mượt hơn, không bị lag hình
    Theme = "Dark", 
    MinimizeKey = Enum.KeyCode.RightControl -- Đổi sang phím Ctrl bên phải để không vướng nút combo game
})

-- Khởi tạo danh mục bên trái đúng thứ tự
local Tabs = {
    Shop = Window:AddTab({ Title = "Shop", Icon = "shopping-cart" }),
    Status = Window:AddTab({ Title = "Status", Icon = "user" }),
    SettingFarm = Window:AddTab({ Title = "Setting Farm", Icon = "settings" }),
    Farming = Window:AddTab({ Title = "Farming", Icon = "swords" }),
    StackFarm = Window:AddTab({ Title = "Stack Farm", Icon = "layers" }),
    FarmingOther = Window:AddTab({ Title = "Farming Other", Icon = "plus-circle" }),
    V4AndRace = Window:AddTab({ Title = "V4 and Race", Icon = "shield" })
}

-- Bố trí thành phần cho mục Farming
Tabs.Farming:AddParagraph({ Title = "Hệ Thống Tự Động Farm", Content = "Tích chọn các mục muốn chạy rồi nhấn Start Farm." })

Tabs.Farming:AddMultiDropdown("MultiDropdownFarm", {
    Title = "Chọn kiểu farm cần làm",
    Values = {"Farm Level", "Farm Bones"},
    Default = {},
    Callback = function(Value)
        _G.DanhSachFarmDaChon = Value 
    end
})

Tabs.Farming:AddToggle("StartFarmToggle", {
    Title = "Start Farm",
    Default = false,
    Callback = function(Value)
        _G.IsStartFarm = Value 
    end
})

-- =============================================================================
-- LỆNH BẮT BUỘC MENU PHẢI BẬT LÊN TRÊN MÀN HÌNH CHÍNH
-- =============================================================================
Window:SelectTab(1) 

-- Gửi thông báo nhỏ góc màn hình xác nhận menu đã sẵn sàng
Fluent:Notify({
    Title = "Blox Fruit Menu",
    Content = "Menu đã mở thành công! Bấm nút Ctrl Phải để Ẩn/Hiện.",
    Duration = 5
})
