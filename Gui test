-- Dán và chạy trong executor (Synapse/KRNL...) khi vào Blox Fruit

-- ======================
-- Tải Fluent an toàn
-- ======================
local url = "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
local Fluent
do
    local ok, res = pcall(function()
        local src = game:HttpGet(url)
        local f = loadstring(src)
        return f()
    end)
    if not ok then
        error("Không thể tải/khởi tạo Fluent UI: " .. tostring(res))
    end
    Fluent = res
end

