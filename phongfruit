-- ── Fruit ESP ────────────────────────────────────────────────────────────────
local _activeESPs = {}

local function addFruitESP(handle, fruitName)
    if not handle or not handle.Parent then return end
    if handle:FindFirstChild("_PhongESP") then return end

    local folder = Instance.new("Folder", handle)
    folder.Name = "_PhongESP"
    _activeESPs[handle] = folder

    local billboard = Instance.new("BillboardGui", folder)
    billboard.Adornee      = handle
    billboard.Size         = UDim2.new(0, 180, 0, 26)
    billboard.StudsOffset  = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop  = true
    billboard.LightInfluence = 0
    billboard.MaxDistance  = 2000
    billboard.ClipsDescendants = false

    local label = Instance.new("TextLabel", billboard)
    label.BackgroundTransparency = 1
    label.Size     = UDim2.fromScale(1, 1)
    label.Font     = Enum.Font.GothamBold
    label.TextSize = 12
    label.RichText = true
    label.TextStrokeTransparency = 0.2
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextColor3 = Color3.fromRGB(255, 255, 255)

    -- Cập nhật text + khoảng cách mỗi 0.1s
    task.spawn(function()
        local lp = game:GetService("Players").LocalPlayer
        while handle and handle.Parent and folder.Parent do
            task.wait(0.1)
            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local dist = root and math.floor((root.Position - handle.Position).Magnitude) or 0
            label.Text = string.format(
                "<b><font color='rgb(255,180,0)'>%s</font></b>\n<font color='rgb(210,210,210)'>%d studs</font>",
                fruitName, dist
            )
        end
        -- Dọn dẹp khi trái biến mất
        if folder and folder.Parent then folder:Destroy() end
        _activeESPs[handle] = nil
    end)
end

local function clearAllESP()
    for handle, folder in pairs(_activeESPs) do
        pcall(function() folder:Destroy() end)
        _activeESPs[handle] = nil
    end
end

