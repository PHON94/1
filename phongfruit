local countedInstances = setmetatable({}, {__mode = "k"})

local function isFruitTool(instance)
    return instance and instance:IsA("Tool")
        and string.find(string.lower(instance.Name), string.lower(FRUIT_NAME_KEY), 1, true) ~= nil
end

-- StoreFruit follows Banana Cat's StoreFruit helper:
-- CommF_:InvokeServer("StoreFruit", fruitKey, fruitTool)
local storingInstances = setmetatable({}, {__mode = "k"})

local function storeFruitTool(instance)
    if not isFruitTool(instance) or storingInstances[instance] then return false end
    storingInstances[instance] = true

    local displayName = string.gsub(instance.Name, " Fruit", "")
    local fruitKey = instance:GetAttribute("OriginalName") or (displayName .. "-" .. displayName)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")

    if not commF or not commF:IsA("RemoteFunction") then
        storingInstances[instance] = nil
        setStatus("Store failed: CommF_ remote not found", false)
        return false
    end

    local ok, result = pcall(function()
        return commF:InvokeServer("StoreFruit", fruitKey, instance)
    end)

    if not ok or result == false then
        storingInstances[instance] = nil
        setStatus("Fruit collected • store request failed", false)
        return false
    end

    setStatus("Fruit collected • storing in inventory...", true)
    return true
end

local function countFruitTool(instance)
    if not isFruitTool(instance) or countedInstances[instance] then return end
    countedInstances[instance] = true
    fruitCount += 1
    countLabel.Text = tostring(fruitCount)
    saveCounter()
    setStatus("Fruit collected successfully!", true)

    task.spawn(function()
        task.wait(0.25)
        storeFruitTool(instance)
    end)
end

local function watchContainer(container)
    if not container then return end
    -- Existing fruit is not counted as newly collected on script startup.
    for _, item in ipairs(container:GetChildren()) do
        if isFruitTool(item) then
            countedInstances[item] = true
        end
    end
    container.ChildAdded:Connect(function(item)
        task.wait(0.15)
        countFruitTool(item)
    end)
end

