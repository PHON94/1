        local level = leaderstats:FindFirstChild("Level") or leaderstats:FindFirstChild("level")
        if level and (level:IsA("IntValue") or level:IsA("NumberValue") or level:IsA("StringValue")) then
            return tostring(level.Value)
        end
    end
    return "N/A"
end

