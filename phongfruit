-- Fruit search: kết hợp BananaCat (whitelist từ server) + QuantumOnyx (quét workspace + Map, fallback PrimaryPart)
-- Lấy danh sách tên trái hợp lệ từ server (giống BananaCat whitelistedfruit)
local _fruitWhitelist = {}
local function buildFruitWhitelist()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if not commF then return end
        local ok, fruits = pcall(function()
            return commF:InvokeServer("GetFruits", false)
        end)
        if ok and type(fruits) == "table" then
            for _, g in pairs(fruits) do
                if g and g.Name then
                    -- BananaCat style: "Dragon-Dragon" → "Dragon Fruit"
                    local shortName = string.split(g.Name, "-")[1]
                    _fruitWhitelist[shortName .. " Fruit"] = true
                end
            end
        end
    end)
end
task.spawn(buildFruitWhitelist)

-- Khoảng cách tối đa để xét là trái hợp lệ (tránh bẫy ở vị trí bất thường)
local MAX_FRUIT_DIST = 3000

local function isFruitModel(obj)
    if not (obj:IsA("Tool") or obj:IsA("Model")) then return false end
    -- Phải có Handle trực tiếp trong obj (không phải Handle của NPC con bên trong)
    local handle = obj:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return false end
    local name = obj.Name
    if not string.find(name, "Fruit", 1, true) then return false end
    -- Nếu whitelist đã load → chỉ nhận tên nằm trong whitelist (BananaCat style)
    if next(_fruitWhitelist) ~= nil then
        return _fruitWhitelist[name] == true
    end
    -- Whitelist chưa load → chấp nhận tên có "Fruit" nhưng phải đúng format "Xxx Fruit"
    -- (loại bỏ tên 1 chữ "Fruit" mơ hồ khi chưa có whitelist)
    return name:match("^.+ Fruit$") ~= nil
end

-- Trả về (fruitModel, handle, distance) để main loop dùng thống nhất
local function findNearestFruit()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, bestHandle, bestDistance = nil, nil, math.huge

    -- Trái trong Blox Fruits luôn spawn trực tiếp dưới workspace (không trong subfolder)
    for _, obj in ipairs(workspace:GetChildren()) do
        if isFruitModel(obj) then
            local handle = obj:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                local distance = (handle.Position - root.Position).Magnitude
                -- Bỏ qua nếu quá xa (tránh bẫy / object bất thường)
                if distance < bestDistance and distance <= MAX_FRUIT_DIST then
                    best = obj
                    bestHandle = handle
                    bestDistance = distance
                end
            end
        end
    end
    return best, bestHandle, bestDistance
end

-- ── Fly system (BananaCat-style coroutine mover) ─────────────────────────
-- Hằng số điều chỉnh tốc độ bay
local FLY_MAX_STEP   = 60      -- studs tối đa mỗi frame (hard cap chống overshoot)
local FLY_STUCK_TIME = 2.5     -- giây không tiến được → coi là stuck
local FLY_CAP_GROW   = 1.08    -- hệ số tăng cap mỗi 1.5 s
local FLY_CAP_SHRINK = 0.7     -- hệ số giảm cap khi stuck
local FLY_CAP_RAISE  = 1.5     -- giây giữa 2 lần raise cap
local ARRIVE_DIST    = 5       -- studs coi là đã tới

-- Trạng thái coroutine hiện tại
local activeFlyCoro  = nil
local activeFlyHandle = { cancelled = false }

-- Đặt BodyVelocity zero để chống rơi khi đứng yên
local function ensureFloatForce(root)
    if root:FindFirstChild("__PhongFloat") then return end
    local bv = Instance.new("BodyVelocity")
    bv.Name       = "__PhongFloat"
    bv.Velocity   = Vector3.zero
    bv.MaxForce   = Vector3.new(1e5, 1e5, 1e5)
    bv.P          = 1e4
    bv.Parent     = root
end

local function removeFloatForce(root)
    local bv = root and root:FindFirstChild("__PhongFloat")
    if bv then bv:Destroy() end
end

local function cancelFly()
    activeFlyHandle.cancelled = true
    if activeFlyCoro and coroutine.status(activeFlyCoro) == "suspended" then
        pcall(coroutine.close, activeFlyCoro)
    end
    activeFlyCoro   = nil
    activeFlyHandle = { cancelled = false }
end

local function moveToFruit(handle)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not handle or not handle.Parent then return false end

    -- Hủy lượt bay trước nếu còn
    cancelFly()

    local targetCF = handle.CFrame * CFrame.new(0, 2.5, 0)
    local targetPos = targetCF.Position

    if (targetPos - root.Position).Magnitude <= ARRIVE_DIST then
        return true
    end

    -- Gắn BodyVelocity chống rơi
    ensureFloatForce(root)

    -- Noclip mỗi Stepped
    local originalCollision = {}
    local noclipConn
    local function applyNoclip()
        local ch = LocalPlayer.Character
        if not ch then return end
        for _, part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    end
    local function stopNoclip()
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        for part, was in pairs(originalCollision) do
            if part and part.Parent then
                pcall(function() part.CanCollide = was end)
            end
        end
        table.clear(originalCollision)
    end
    applyNoclip()
    noclipConn = game:GetService("RunService").Stepped:Connect(applyNoclip)

    -- Tạo handle cho lượt này
    local thisHandle = activeFlyHandle
    local arrived    = false

    -- Coroutine bay — thuật toán BananaCat
    local coro = coroutine.create(function()
        local RunService = game:GetService("RunService")

        -- Trạng thái speed-ramp
        local capState = { cap = 80, nextRaise = 0 }  -- ramp từ 80 → MOVE_SPEED

        local fromPos   = root.Position          -- vị trí "bàn đạp" hiện tại
        local bestDist  = math.huge              -- khoảng cách gần nhất đạt được
        local lastImproveTime = tick()
        local prevPos   = fromPos
        local prevDist  = (targetPos - fromPos).Magnitude

        while not thisHandle.cancelled do
            local ch = LocalPlayer.Character
            local r  = ch and ch:FindFirstChild("HumanoidRootPart")
            if ch ~= character or not r or not handle.Parent then break end

            local dt = RunService.Heartbeat:Wait()
            local curPos  = r.Position
            local distToTarget = (targetPos - curPos).Magnitude

            -- Cập nhật best distance & detect stuck
            if distToTarget < bestDist - 5 then
                bestDist          = distToTarget
                lastImproveTime   = tick()
            else
                if tick() - lastImproveTime > FLY_STUCK_TIME then
                    -- Stuck: giảm cap, reset anchor
                    capState.cap      = math.max(capState.cap * FLY_CAP_SHRINK, 80)
                    capState.nextRaise = tick() + 3
                    fromPos = curPos
                end
            end

            -- Cập nhật fromPos nếu di chuyển đáng kể
            if (curPos - prevPos).Magnitude > 40 then
                fromPos = curPos
            end

            -- Tính step size cho frame này (studs/s * dt = studs bước này)
            local effectiveCap = math.min(capState.cap, MOVE_SPEED)
            local stepSize     = math.min(effectiveCap * dt, FLY_MAX_STEP)

            -- Raise cap dần nếu không stuck
            if distToTarget > stepSize and tick() >= capState.nextRaise then
                capState.cap      = math.min(capState.cap * FLY_CAP_GROW, MOVE_SPEED)
                capState.nextRaise = tick() + FLY_CAP_RAISE
            end

            -- Tính vị trí mới
            local dir    = targetPos - fromPos
            local dirMag = dir.Magnitude
            local newPos
            if dirMag <= stepSize or dirMag < 0.05 then
                newPos = targetPos
            else
                newPos = fromPos + dir / dirMag * stepSize
            end
            fromPos = newPos

            -- Áp CFrame + zero velocity
            r.CFrame                   = CFrame.new(newPos)
            r.AssemblyLinearVelocity   = Vector3.zero
            r.AssemblyAngularVelocity  = Vector3.zero

            prevPos  = newPos
            prevDist = distToTarget

            -- Kiểm tra tới nơi
            if (targetPos - newPos).Magnitude <= ARRIVE_DIST then
                -- Snap chính xác
                r.CFrame                  = targetCF
                r.AssemblyLinearVelocity  = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
                arrived = true
                break
            end
        end
    end)

    activeFlyCoro = coro
    coroutine.resume(coro)

    -- Wait loop — chờ coroutine xong
    -- Chờ đến khi bay tới nơi (coro tự chết) hoặc bị cancel do stop/handle mất/character đổi
    while coroutine.status(coro) ~= "dead" do
        if ENV.PhongFruitCollectorStop or not handle.Parent
            or LocalPlayer.Character ~= character then
            cancelFly()
            stopNoclip()
            removeFloatForce(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            return false
        end
        task.wait(0.05)
    end

    -- Cleanup
    if activeFlyCoro == coro then cancelFly() end
    stopNoclip()
    removeFloatForce(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
    return handle.Parent ~= nil
end

-- Server hop uses the same in-game __ServerBrowser RemoteFunction pattern
-- as the supplied source. It avoids the current JobId and retries safely.
local hopping = false
local function hopServer()
    if hopping then return end
    hopping = true

    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not browser or not browser:IsA("RemoteFunction") then
        setStatus("Server browser remote not found", false)
        hopping = false
        return false
    end

    local tried = {}
    local attempt = 0
    local MAX_ATTEMPTS = 5  -- sau 5 lần không tìm được → bỏ, để main loop tiếp tục

    while not ENV.PhongFruitCollectorStop and attempt < MAX_ATTEMPTS do
        -- Quét tất cả page, thu thập candidates (không lọc theo playerCount vì data không đáng tin)
        local candidates = {}
        for page = 1, 20 do
            if ENV.PhongFruitCollectorStop then break end
            local ok, servers = pcall(function()
                return browser:InvokeServer(page)
            end)
            if ok and type(servers) == "table" then
                for jobId in pairs(servers) do
                    if jobId ~= game.JobId and not tried[jobId] then
                        table.insert(candidates, jobId)
                    end
                end
            end
            task.wait(0.05)
        end

        if #candidates == 0 then
            attempt += 1
            setStatus("No servers found • retry " .. attempt .. "/" .. MAX_ATTEMPTS, false)
            task.wait(3)
        else
            -- Thử lần lượt từng server, skip nếu không teleport được sau 4s
            for _, jobId in ipairs(candidates) do
                if ENV.PhongFruitCollectorStop then break end
                tried[jobId] = true
                attempt += 1
                setStatus("🌐 Đang hop server " .. attempt .. "...", false)

                local currentJob = game.JobId
                pcall(function()
                    browser:InvokeServer("teleport", jobId)
                end)

                -- Chờ tối đa 4s xem có chuyển server không
                local t0 = os.clock()
                repeat task.wait(0.5) until game.JobId ~= currentJob
                    or os.clock() - t0 >= 4
                    or ENV.PhongFruitCollectorStop

                if game.JobId ~= currentJob then
                    return true  -- teleport thành công
                end
                -- Nếu vẫn cùng server → đầy hoặc lỗi, thử tiếp
                setStatus("🌐 Server đầy • thử server khác...", false)
            end
        end
    end

    hopping = false
    setStatus("Hop failed • resuming scan...", false)
    return false
end

