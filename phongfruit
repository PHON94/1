local function decodeBase64(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local values = {}
    for i = 1, #alphabet do
        values[string.sub(alphabet, i, i)] = i - 1
    end

    local output = {}
    data = string.gsub(data, "[^%w%+/=]", "")
    for i = 1, #data, 4 do
        local c1 = values[string.sub(data, i, i)] or 0
        local c2 = values[string.sub(data, i + 1, i + 1)] or 0
        local c3char = string.sub(data, i + 2, i + 2)
        local c4char = string.sub(data, i + 3, i + 3)
        local c3 = values[c3char] or 0
        local c4 = values[c4char] or 0

        local n = c1 * 262144 + c2 * 4096 + c3 * 64 + c4
        output[#output + 1] = string.char(math.floor(n / 65536) % 256)
        if c3char ~= "=" and c3char ~= "" then
            output[#output + 1] = string.char(math.floor(n / 256) % 256)
        end
        if c4char ~= "=" and c4char ~= "" then
            output[#output + 1] = string.char(n % 256)
        end
    end
    return table.concat(output)
end

