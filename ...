local function loadCounter()
    if type(isfile) == "function" and isfile(COUNTER_FILE)
        and type(readfile) == "function" then
        local raw  = safeCall(readfile, COUNTER_FILE)
        local data = raw and safeCall(function()
            return HttpService:JSONDecode(raw)
        end)
        if type(data) == "table" and tonumber(data.count) then
            return math.max(0, math.floor(tonumber(data.count)))
        end
    end
    return tonumber(ENV.PhongFruitCollectorCount) or 0
end

local fruitCount = loadCounter()
ENV.PhongFruitCollectorCount = fruitCount

local function saveCounter()
    ENV.PhongFruitCollectorCount = fruitCount
    if type(writefile) == "function" then
        local encoded = safeCall(function()
            return HttpService:JSONEncode({ count = fruitCount })
        end)
        if encoded then safeCall(writefile, COUNTER_FILE, encoded) end
    end
end

-- ── Furina background asset (embedded JPEG, base64) ─────────────────────────
local FURINA_IMAGE_B64 = ""
local FURINA_IMAGE_PATH = "PhongFruitCollector/furina_bg.jpg"

local furinaAsset
do
    local function decodeB64(data)
        local alpha  = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local vals   = {}
        for i = 1, #alpha do vals[alpha:sub(i,i)] = i - 1 end
        local out    = {}
        data = data:gsub("[^%w%+/=]", "")
        for i = 1, #data, 4 do
            local c1 = vals[data:sub(i,i)]   or 0
            local c2 = vals[data:sub(i+1,i+1)] or 0
            local s3 = data:sub(i+2,i+2)
            local s4 = data:sub(i+3,i+3)
            local c3 = vals[s3] or 0
            local c4 = vals[s4] or 0
            local n  = c1*262144 + c2*4096 + c3*64 + c4
            out[#out+1] = string.char(math.floor(n/65536) % 256)
            if s3 ~= "=" and s3 ~= "" then
                out[#out+1] = string.char(math.floor(n/256) % 256)
            end
            if s4 ~= "=" and s4 ~= "" then
                out[#out+1] = string.char(n % 256)
            end
        end
        return table.concat(out)
    end

    if type(writefile) == "function" then
        if not (type(isfile) == "function" and isfile(FURINA_IMAGE_PATH)) then
            pcall(writefile, FURINA_IMAGE_PATH, decodeB64(FURINA_IMAGE_B64))
        end
    end
    local loader = getcustomasset or getsynasset
    if type(loader) == "function" then
        local ok, asset = pcall(loader, FURINA_IMAGE_PATH)
        if ok then furinaAsset = asset end
    end
end

-- ── Team selection (replaces undefined FireButton) ───────────────────────────
-- Blox Fruits stores team selection via a RemoteEvent or through a GUI button.
-- We wait for the ChooseTeam GUI and click the Marines TextButton remotely
-- using :FireServer on the event typically wired to it, or fall back to
-- simply triggering the button's MouseButton1Click connection.
local function selectMarinesTeam()
    local gui = PlayerGui:WaitForChild("Main (minimal)", 15)
              or PlayerGui:WaitForChild("Main", 15)
    if not gui then return end

    -- Wait for ChooseTeam container
    local chooseTeam = gui:WaitForChild("ChooseTeam", 10)
    if not chooseTeam then return end

    local btn = safeCall(function()
        return chooseTeam.Container.Marines.Frame.TextButton
    end)
    if btn and btn:IsA("TextButton") then
        -- Fire all MouseButton1Click connections on the button
        local conns = {}
        for _, c in ipairs(btn:GetConnections and btn:GetConnections("MouseButton1Click") or {}) do
            pcall(function() c:Fire() end)
        end
        -- Fallback: use the FireServer pattern observed in many Blox Fruits GUIs
        local remote = ReplicatedStorage:FindFirstChild("Remotes")
        if remote then
            local ev = remote:FindFirstChild("CommE")
            if ev and ev:IsA("RemoteEvent") then
                pcall(function() ev:FireServer("ChooseTeam", "Marines") end)
            end
        end
    end
end

