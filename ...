local activeTween         = nil
local activeLinearVelocity = nil

local function destroyLinearVelocity()
    if activeLinearVelocity then
        pcall(function() activeLinearVelocity:Destroy() end)
        activeLinearVelocity = nil
    end
end

-- Clean up LV whenever character respawns
LocalPlayer.CharacterAdded:Connect(destroyLinearVelocity)

local function setupLinearVelocity(root)
    destroyLinearVelocity()
    local att = root:FindFirstChild("__PhongLVAtt")
    if not att then
        att = Instance.new("Attachment")
        att.Name     = "__PhongLVAtt"
        att.Position = Vector3.zero
        att.Parent   = root
    end
    local lv = Instance.new("LinearVelocity")
    lv.Name           = "__PhongLV"
    lv.Attachment0    = att
    lv.MaxForce       = 1e6
    lv.RelativeTo     = Enum.ActuatorRelativeTo.World
    lv.VectorVelocity = Vector3.zero
    lv.Parent         = root
    activeLinearVelocity = lv
    return lv
end

local function findNearestFruit()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if (obj:IsA("Tool") or obj:IsA("Model"))
            and obj.Name:lower():find("fruit", 1, true) then
            local handle = obj:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                local d = (handle.Position - root.Position).Magnitude
                if d < bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end
    return best, bestDist
end

local function moveToFruit(handle)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not handle or not handle.Parent then return false end

    -- Cancel any in-progress tween
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    destroyLinearVelocity()

    if (handle.Position - root.Position).Magnitude <= 5 then
        return true
    end

    local target   = handle.CFrame * CFrame.new(0, 2.5, 0)
    local distance = (target.Position - root.Position).Magnitude
    local duration = math.clamp(distance / MOVE_SPEED, 0.15, 12)

    -- Noclip
    local origCollide = {}
    local noclipConn

    local function applyNoclip()
        local c = LocalPlayer.Character
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                if origCollide[p] == nil then origCollide[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    end

    local function stopNoclip()
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        for p, v in pairs(origCollide) do
            if p and p.Parent then pcall(function() p.CanCollide = v end) end
        end
        table.clear(origCollide)
    end

    applyNoclip()
    noclipConn = RunService.Stepped:Connect(applyNoclip)

    -- Tween the CFrame
    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = target }
    )
    activeTween = tween
    local finished = false
    local tweenConn
    tweenConn = tween.Completed:Connect(function()
        finished = true
        tweenConn:Disconnect()
    end)
    tween:Play()

    -- LinearVelocity running in parallel
    local lv    = setupLinearVelocity(root)
    local lvConn = RunService.Heartbeat:Connect(function()
        if not lv or not lv.Parent then return end
        local cr = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not cr or not handle.Parent then return end
        local dir = target.Position - cr.Position
        lv.VectorVelocity = dir.Magnitude < 2 and Vector3.zero
                            or dir.Unit * MOVE_SPEED
    end)

    -- Wait for completion or abort
    local t0 = os.clock()
    while not finished and (os.clock() - t0) < duration + 1 do
        if ENV.PhongFruitCollectorStop
            or not handle.Parent
            or LocalPlayer.Character ~= char then
            pcall(function() tween:Cancel() end)
            break
        end
        task.wait(0.1)
    end

    lvConn:Disconnect()
    destroyLinearVelocity()
    stopNoclip()
    if activeTween == tween then activeTween = nil end

    return handle.Parent ~= nil
end

-- ── Server hop ───────────────────────────────────────────────────────────────
local hopping = false

local function hopServer()
    if hopping then return false end
    hopping = true
    setStatus("No fruit found — changing server…", false)

    local browser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not browser or not browser:IsA("RemoteFunction") then
        setStatus("__ServerBrowser remote not found", false)
        hopping = false
        return false
    end

    for page = 1, 100 do
        if ENV.PhongFruitCollectorStop then break end
        local ok, servers = pcall(function()
            return browser:InvokeServer(page)
        end)
        if ok and type(servers) == "table" then
            for jobId in pairs(servers) do
                if jobId ~= game.JobId then
                    local hopOk = pcall(function()
                        browser:InvokeServer("teleport", jobId)
                    end)
                    if hopOk then
                        setStatus("Joining another server…", false)
                        hopping = false
                        return true
                    end
                end
            end
        end
        task.wait(0.15)
    end

    hopping = false
    return false
end

-- ── Main loop ─────────────────────────────────────────────────────────────────
task.spawn(function()
    task.wait(1.2)
    setStatus("Searching for fruits…", true)

    while not ENV.PhongFruitCollectorStop do
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not hum or hum.Health <= 0 then
            setStatus("Waiting for character…", false)
            task.wait(2)
        else
            local fruit = findNearestFruit()
            local handle = fruit and fruit:FindFirstChild("Handle")

            if fruit and handle then
                setStatus("Moving to " .. fruit.Name .. "…", true)
                moveToFruit(handle)

                -- Wait briefly for the fruit to appear in Backpack
                local deadline = os.clock() + 3
                while os.clock() < deadline and not ENV.PhongFruitCollectorStop do
                    if not fruit.Parent or not handle.Parent then break end
                    task.wait(0.2)
                end
                if fruit.Parent then
                    setStatus("Fruit still on map — retrying…", false)
                    task.wait(1)
                end
            else
                setStatus("No fruit on map — hopping in " .. HOP_DELAY .. "s…", false)
                task.wait(HOP_DELAY)
                if not ENV.PhongFruitCollectorStop then
                    hopServer()
                end
                task.wait(2)
            end
        end

        task.wait(SCAN_DELAY)
    end

    -- Cleanup on stop
    if activeTween then pcall(function() activeTween:Cancel() end) end
    destroyLinearVelocity()
    setStatus("Collector stopped.", false)
    ENV.PhongFruitCollectorRunning = false
end)

