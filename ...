-- ── CommF_ / CommE remote finder ─────────────────────────────────────────────
-- Blox Fruits may nest remotes differently across updates.
local function findRemote(name, class)
    class = class or "RemoteFunction"
    -- Common paths: RS.Remotes.X, RS.X
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local r = remotes:FindFirstChild(name)
        if r and r:IsA(class) then return r end
    end
    local r2 = ReplicatedStorage:FindFirstChild(name)
    if r2 and r2:IsA(class) then return r2 end
    return nil
end

-- ── Fruit collection tracking ────────────────────────────────────────────────
local countedInstances  = setmetatable({}, { __mode = "k" })
local storingInstances  = setmetatable({}, { __mode = "k" })

local function isFruitTool(inst)
    return inst and inst:IsA("Tool")
        and inst.Name:lower():find(FRUIT_NAME_KEY:lower(), 1, true) ~= nil
end

local function storeFruitTool(instance)
    if not isFruitTool(instance) or storingInstances[instance] then
        return false
    end
    storingInstances[instance] = true

    local displayName = instance.Name:gsub(" Fruit", "")
    local fruitKey    = instance:GetAttribute("OriginalName")
                     or (displayName .. "-" .. displayName)

    local commF = findRemote("CommF_", "RemoteFunction")
    if not commF then
        storingInstances[instance] = nil
        setStatus("Store failed: CommF_ not found", false)
        return false
    end

    local ok = pcall(function()
        commF:InvokeServer("StoreFruit", fruitKey, instance)
    end)

    storingInstances[instance] = nil   -- always clear
    if not ok then
        setStatus("Store request failed", false)
        return false
    end
    setStatus("Fruit stored in inventory!", true)
    return true
end

local function countFruitTool(instance)
    if not isFruitTool(instance) or countedInstances[instance] then return end
    countedInstances[instance] = true
    fruitCount += 1
    if countLabel and countLabel.Parent then
        countLabel.Text = tostring(fruitCount)
    end
    saveCounter()
    setStatus("Fruit collected!", true)
    task.spawn(function()
        task.wait(0.25)
        storeFruitTool(instance)
    end)
end

local function watchContainer(container)
    if not container then return end
    -- Mark already-present items so we don't double-count on startup
    for _, item in ipairs(container:GetChildren()) do
        if isFruitTool(item) then countedInstances[item] = true end
    end
    container.ChildAdded:Connect(function(item)
        task.wait(0.15)
        countFruitTool(item)
    end)
end

