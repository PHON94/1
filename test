local function resolveSelectedWeapon()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    local selected = nil

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == ChooseWeapon then
                selected = tool.Name
                break
            end
        end
    end

    if not selected and character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == ChooseWeapon then
                selected = tool.Name
                break
            end
        end
    end

    SelectWeapon = selected
    _G.SelectWeapon = selected

    if selected then
        WeaponResolved.Text = "Đang chọn: " .. selected
        WeaponResolved.TextColor3 = Color3.fromRGB(88, 224, 132)
    else
        WeaponResolved.Text = "Chưa tìm thấy " .. ChooseWeapon
        WeaponResolved.TextColor3 = Color3.fromRGB(255, 180, 70)
    end

    return selected
end

-- Source-style automatic weapon selection, driven by the Setting choice.
local function SourceResolveWeapon()
    local wanted = _G.ChooseWP or ChooseWeapon
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character

    if backpack then
        for _, v in pairs(backpack:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == wanted then
                _G.SelectWeapon = v.Name
                SelectWeapon = v.Name
                return v.Name
            end
        end
    end

    if character then
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == wanted then
                _G.SelectWeapon = v.Name
                SelectWeapon = v.Name
                return v.Name
            end
        end
    end

    return nil
end

EquipWeapon = function(text)
    if not _G.AutoLevel then return end
    if not text then return end

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
