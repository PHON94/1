--===========================================================================

local _B = true
local BringSourceConnection = nil

local function StopBringMobs()
    if BringSourceConnection then
        BringSourceConnection:Disconnect()
        BringSourceConnection = nil
    end

    -- Remove only BodyVelocity objects created by this routine.
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            local root = mob:FindFirstChild("HumanoidRootPart")
            local bv = root and root:FindFirstChild("PhongdzSourceBringVelocity")
            if bv then
                pcall(function() bv:Destroy() end)
            end
        end
    end
end

local function IsSourceNetworkOwner(part)
    local ok, owner = pcall(function()
        if typeof(isnetworkowner) == "function" then
            return isnetworkowner(part)
        end
        return nil
    end)

    if ok and owner ~= nil then
        return owner
    end

    return part.ReceiveAge == 0
        and not part.Anchored
        and part.AssemblyLinearVelocity.Magnitude > 0
end

local function BringEnemy(Mon)
    if not _B or not Mon then
        return
    end

    local enemies = workspace:FindFirstChild("Enemies")
    local targetRoot = Mon:FindFirstChild("HumanoidRootPart")
    if not enemies or not targetRoot then
        return
    end

    local targetPos = targetRoot.Position

    -- Source creates/maintains one worker instead of creating a new loop
    -- for every mob.
    if BringSourceConnection then
        return
    end

    BringSourceConnection = RunService.Heartbeat:Connect(function()
        if not _G.AutoLevel or not _B then
            StopBringMobs()
            return
        end

        if not Mon.Parent then
            StopBringMobs()
            return
        end

        local currentRoot = Mon:FindFirstChild("HumanoidRootPart")
        local currentHum = Mon:FindFirstChildOfClass("Humanoid")
        if not currentRoot or not currentHum or currentHum.Health <= 0 then
            StopBringMobs()
            return
        end

        local center = currentRoot.Position
        local areaMob = false

        for _, mob in ipairs(enemies:GetChildren()) do
            if mob ~= Mon and mob.Name == Mon.Name then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local root = mob:FindFirstChild("HumanoidRootPart")

                if hum and root and hum.Health > 0 then
                    local distance = (root.Position - center).Magnitude

                    if distance <= 3000 then
                        local bv = root:FindFirstChild("PhongdzSourceBringVelocity")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "PhongdzSourceBringVelocity"
                            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                            bv.Velocity = Vector3.zero
                            bv.Parent = root
                        end

                        if distance <= 10 then
                            areaMob = true
                        end

                        if not areaMob and IsSourceNetworkOwner(root) then
                            root.CFrame = CFrame.new(center)
                        end

                        root.CanCollide = false
                        hum.WalkSpeed = 0
                        hum.JumpPower = 0
                    end
                end
            end
        end

        currentRoot.CanCollide = false
        currentHum.WalkSpeed = 0
        currentHum.JumpPower = 0
    end)
end

local SourceFastAttack = {
    LastFire = 0,
    Interval = 0.035,
    Range = 60,
    AttackRemote = nil,
    HitRemote = nil,
}

local function GetSourceFastAttackRemotes()
    if SourceFastAttack.AttackRemote and SourceFastAttack.HitRemote
        and SourceFastAttack.AttackRemote.Parent and SourceFastAttack.HitRemote.Parent then
        return SourceFastAttack.AttackRemote, SourceFastAttack.HitRemote
    end

    local ok = pcall(function()
        local storage = ReplicatedStorage
        local modules = storage:FindFirstChild("Modules")
        local net = modules and modules:FindFirstChild("Net")
        if not net then return end

        SourceFastAttack.AttackRemote = net:FindFirstChild("RE/RegisterAttack")
        SourceFastAttack.HitRemote = net:FindFirstChild("RE/RegisterHit")
    end)

    if ok and SourceFastAttack.AttackRemote and SourceFastAttack.HitRemote then
        return SourceFastAttack.AttackRemote, SourceFastAttack.HitRemote
    end

    return nil, nil
end

-- Source-derived target scan: enemies only, so this farm routine never
-- intentionally targets other players.
local function GetSourceFarmTargets(character, range)
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not enemiesFolder or not root then return {} end

    local targets = {}
    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        if enemy.Name == Ms and not enemy:GetAttribute("IsBoat") then
            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            if enemyRoot and hum and hum.Health > 0 then
                if (enemyRoot.Position - root.Position).Magnitude <= range then
                    targets[#targets + 1] = enemy
                end
            end
        end
    end
    return targets
end

-- Source-style hit-part selection. Prefer combat limbs, then Head/PrimaryPart.
local function GetSourceHitPart(enemy)
    local limbs = {
        "RightLowerArm", "RightUpperArm", "LeftLowerArm",
        "LeftUpperArm", "RightHand", "LeftHand"
    }

    for _, name in ipairs(limbs) do
        local part = enemy:FindFirstChild(name)
        if part then return part end
    end

    return enemy:FindFirstChild("Head") or enemy.PrimaryPart
end

local function FastAttack()
    if not _G.AutoLevel then return end
    if os.clock() - SourceFastAttack.LastFire < SourceFastAttack.Interval then return end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not hum or hum.Health <= 0 then return end

    local equippedWeapon = character:FindFirstChildOfClass("Tool")
    if not equippedWeapon then
        equippedWeapon = EquipFarmWeapon()
    end
    if not equippedWeapon then return end

    -- Keep the existing weapon selector intact.
    if ChooseWeapon == "Blox Fruit" and not FruitM1Enabled then
        return
    end

    local targets = GetSourceFarmTargets(character, SourceFastAttack.Range)
    if #targets == 0 then return end

    local attackEvent, hitEvent = GetSourceFastAttackRemotes()
    if not attackEvent or not hitEvent then return end

    local hitTargets = {}
    local mainTarget = nil

    for _, enemy in ipairs(targets) do
        local hitPart = GetSourceHitPart(enemy)
        if hitPart then
            hitTargets[#hitTargets + 1] = {enemy, hitPart}
            mainTarget = mainTarget or hitPart
        end
    end

    if not mainTarget or #hitTargets == 0 then return end

    -- Match the source's combat-remote-thread branch when available.
    local sent = false
    pcall(function()
        attackEvent:FireServer(0)
        sent = true
    end)

    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local flagsModule = modules and modules:FindFirstChild("Flags")
    local combatRemoteThread = false

    if flagsModule then
        pcall(function()
            combatRemoteThread = require(flagsModule).COMBAT_REMOTE_THREAD or false
        end)
    end

    if combatRemoteThread then
        -- Some executors expose the source's SendHitsToServer through the
        -- current PlayerScripts environment. Use it when available.
        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
        local localScript = playerScripts and playerScripts:FindFirstChildOfClass("LocalScript")
        local hitFunction

        if localScript and type(getsenv) == "function" then
            pcall(function()
                local env = getsenv(localScript)
                if env then hitFunction = env._G and env._G.SendHitsToServer end
            end)
        end

        if type(hitFunction) == "function" then
            pcall(function()
                hitFunction(mainTarget, hitTargets)
                sent = true
            end)
        else
            pcall(function()
                hitEvent:FireServer(mainTarget, hitTargets)
                sent = true
            end)
        end
    else
        pcall(function()
            hitEvent:FireServer(mainTarget, hitTargets)
            sent = true
        end)
    end

    if sent then
        SourceFastAttack.LastFire = os.clock()
    end
end

local function QuestText()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local q = main and main:FindFirstChild("Quest")
    local c = q and q:FindFirstChild("Container")
    local qt = c and c:FindFirstChild("QuestTitle")
    local title = qt and qt:FindFirstChild("Title")

    -- Fallback for UI variants that nest the title differently.
    if not title and q then
        for _, obj in ipairs(q:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(
                string.lower(obj.Text or ""),
                string.lower(NameMon or ""),
                1,
                true
            ) then
                title = obj
                break
            end
        end
    end

    return q, title
end


-- Stable no-gravity state. Do not use VectorForce/BodyVelocity here:
-- those forces fight TweenTo and create an up/down oscillation.
local GravityForce = nil
local GravityAttachment = nil
local GravityRoot = nil

local function RestoreFarmGravity()
    if GravityForce then
        pcall(function() GravityForce:Destroy() end)
        GravityForce = nil
    end
    if GravityAttachment then
        pcall(function() GravityAttachment:Destroy() end)
        GravityAttachment = nil
    end
    GravityRoot = nil
end

local function DisableFarmGravity()
    local root = GetRoot()
    if not root then return end

    if GravityRoot == root and GravityForce and GravityForce.Parent then
        -- Keep exact anti-gravity force updated for the current assembly mass.
        GravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
        return
    end

    RestoreFarmGravity()
    GravityRoot = root

    GravityAttachment = Instance.new("Attachment")
    GravityAttachment.Name = "PhongdzFarmNoGravityAttachment"
    GravityAttachment.Parent = root

    GravityForce = Instance.new("VectorForce")
    GravityForce.Name = "PhongdzFarmNoGravity"
    GravityForce.Attachment0 = GravityAttachment
    GravityForce.RelativeTo = Enum.ActuatorRelativeTo.World
    GravityForce.ApplyAtCenterOfMass = true
    GravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
    GravityForce.Parent = root
end

local function RunFarm()
    if not _G.AutoLevel then
        RestoreFarmGravity()
        StopSourceMovement()
        StopBringMobs()
        return
    end

    -- Keep CheckLevel exactly as it is. The quest/farm flow below follows
    -- the new source's order: validate quest -> go quest NPC -> StartQuest
    -- -> find mob -> move above mob -> attack.
    DisableFarmGravity()
    StartSourceMovement()
    CheckLevel()

    if not NameMon or not NameQuest or not CFrameQ then
        return
    end

    local q, title = QuestText()
    local root = GetRoot()
    if not root then
        return
    end

    local questVisible = q and q.Visible == true
    local questTitle = title and tostring(title.Text or "") or ""

    -- SOURCE-STYLE QUEST FLOW
    -- Wrong quest while a quest is open -> abandon once, then reacquire.
    if questVisible and not string.find(questTitle, tostring(NameMon), 1, true) then
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        local comm = rem and rem:FindFirstChild("CommF_")

        if comm then
            pcall(function()
                comm:InvokeServer("AbandonQuest")
            end)
        end

        return
    end

    -- No quest -> travel to the quest giver and start it only after
    -- reaching the quest position, matching the source's sequencing.
    if not questVisible then
        local distanceToQuest = (root.Position - CFrameQ.Position).Magnitude

        if distanceToQuest > 10 then
            TweenTo(CFrameQ)
            return
        end

        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        local comm = rem and rem:FindFirstChild("CommF_")

        if comm then
            pcall(function()
                comm:InvokeServer("StartQuest", NameQuest, QuestLv)
            end)
        end

        return
    end

    -- SOURCE-STYLE MOB FLOW
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then
        return
    end

    local enemyName = NameMon
    local foundMob = false

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == enemyName then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")

            if hum and mobRoot and hum.Health > 0 then
                foundMob = true

                if ActiveTarget ~= mob then
                    ActiveTarget = mob
                    FarmDestination = nil
                    FarmDestinationTarget = nil
                    StopFarmTween()
                    StopBringMobs()
                end

                AutoHaki()
                local equippedTool = EquipFarmWeapon()

                -- Same source positioning idea: stay above the target.
                -- TweenTo handles the actual movement; no hard CFrame snap.
                TweenTo(mobRoot.CFrame * CFrame.new(0, 20, 0))

                if not _G.AutoLevel then
                    return
                end

                -- Keep the existing BringEnemy implementation.
                BringEnemy(mob)

                -- Keep Fast Attack unchanged.
                if equippedTool and (ChooseWeapon ~= "Blox Fruit" or FruitM1Enabled) then
                    FastAttack()
                end

                pcall(function()
                    mobRoot.CanCollide = false
                    mobRoot.Size = Vector3.new(60, 60, 60)
                    hum.WalkSpeed = 0
                    hum.JumpPower = 0
                end)

                break
            end
        end
    end

    -- SOURCE-STYLE REPLICATED ENEMY FALLBACK
    if not foundMob then
        for _, mob in ipairs(ReplicatedStorage:GetChildren()) do
            if mob.Name == enemyName then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local mobRoot = mob:FindFirstChild("HumanoidRootPart")

                if hum and mobRoot and hum.Health > 0 then
                    foundMob = true
                    TweenTo(mobRoot.CFrame * CFrame.new(0, 20, 0))
                    break
                end
            end
        end
    end

    -- SOURCE-STYLE SPAWN FALLBACK
    if not foundMob then
        local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
        local spawnFolder = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")

        if spawnFolder then
            for _, spawnPoint in ipairs(spawnFolder:GetChildren()) do
                if string.find(tostring(spawnPoint.Name), tostring(enemyName), 1, true) then
                    TweenTo(spawnPoint.CFrame * CFrame.new(0, 20, 0))
                    break
                end
            end
        end
    end
end



