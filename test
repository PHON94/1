local function resolveSelectedWeapon()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character

    local function scan(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == ChooseWeapon then
                return tool.Name
            end
        end
        return nil
    end

    local selected = scan(backpack) or scan(character)
    SelectWeapon = selected
    _G.SelectWeapon = selected

    if selected then
        WeaponResolved.Text = "Đang chọn: " .. selected
        WeaponResolved.TextColor3 = Color3.fromRGB(88, 224, 132)
    else
        WeaponResolved.Text = "Chưa tìm thấy " .. ChooseWeapon
        WeaponResolved.TextColor3 = Color3.fromRGB(255, 180, 70)
    end
end

local function rebuildWeaponOptions()
    for _, child in ipairs(WeaponDrop:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for index, weaponType in ipairs(WeaponOptions) do
        local option = Instance.new("TextButton")
        option.Position = UDim2.fromOffset(5, (index - 1) * 36 + 5)
        option.Size = UDim2.new(1, -10, 0, 32)
        option.BackgroundColor3 =
            weaponType == ChooseWeapon
            and Color3.fromRGB(255, 211, 65)
            or Color3.fromRGB(38, 41, 51)
        option.BorderSizePixel = 0
        option.Text = weaponType
        option.Font = Enum.Font.GothamBold
        option.TextSize = 9
        option.TextColor3 =
            weaponType == ChooseWeapon
            and Color3.fromRGB(16, 18, 24)
            or Color3.fromRGB(235, 238, 244)
        option.AutoButtonColor = false
        option.ZIndex = 51
        option.Parent = WeaponDrop

        local oc = Instance.new("UICorner")
        oc.CornerRadius = UDim.new(0, 7)
        oc.Parent = option

        option.Activated:Connect(function()
            ChooseWeapon = weaponType
            _G.ChooseWeapon = weaponType
            WeaponText.Text = weaponType
            WeaponDrop.Visible = false
            WeaponDrop.Size = UDim2.fromOffset(W - 58, 0)
            Arrow.Text = "▾"
            rebuildWeaponOptions()
            resolveSelectedWeapon()
        end)
    end
end

