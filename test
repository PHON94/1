-- AXIOM_SOURCE_FAST_ATTACK_BEGIN
-- Source-style Fast Attack core.
-- Keeps the existing UI callbacks/flags intact and replaces the attack loop.
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    _G.FastAttack = _G.FastAttack == true
    _G.SelectWeapon = _G.SelectWeapon or nil

    local SourceAttack = {}
    SourceAttack.__index = SourceAttack

    function SourceAttack.Alive(model)
        if not model then return false end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        return humanoid ~= nil and humanoid.Health > 0
    end

    local function getRoot(model)
        return model and model:FindFirstChild("HumanoidRootPart")
    end

    local function equipSelectedWeapon()
        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not character or not backpack then return end

        local selected = _G.SelectWeapon
        if not selected then return end

        local tool = character:FindFirstChild(selected) or backpack:FindFirstChild(selected)
        if tool and tool:IsA("Tool") then
            pcall(function()
                character:FindFirstChildOfClass("Humanoid"):EquipTool(tool)
            end)
        end
    end

    function SourceAttack.Kill(model)
        if not SourceAttack.Alive(model) then return false end

        local root = getRoot(model)
        if not root then return false end

        equipSelectedWeapon()

        -- Movement is owned by Farm Level's TweenTo.
        -- Do not reposition HumanoidRootPart here: doing so fights the
        -- farm movement target and causes the character to jerk vertically.
        return true
    end

    -- Expose the source-style dispatcher without changing the UI.
    _G.SourceFastAttack = SourceAttack

    -- Replace the existing attack worker when the script's flag is enabled.
    task.spawn(function()
        while task.wait(0.05) do
            if _G.FastAttack then
                pcall(function()
                    local enemies = workspace:FindFirstChild("Enemies")
                    if not enemies then return end

                    for _, enemy in ipairs(enemies:GetChildren()) do
                        if SourceAttack.Alive(enemy) then
                            local root = getRoot(enemy)
                            local playerRoot =
                                LocalPlayer.Character and
                                LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                            if root and playerRoot and
                               (root.Position - playerRoot.Position).Magnitude <= 60 then
                                SourceAttack.Kill(enemy)
                                break
                            end
                        end
                    end
                end)
            end
        end
    end)
end
-- AXIOM_SOURCE_FAST_ATTACK_END


