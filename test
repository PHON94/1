local function SourceNearbyTargets(character, folder)
    if not character or not folder then return {} end
    local pos = character:GetPivot().Position
    local result = {}
    for _, target in ipairs(folder:GetChildren()) do
        local humanoid = target:FindFirstChild("Humanoid")
        local rootPart = target:FindFirstChild("HumanoidRootPart")
        if humanoid and rootPart and humanoid.Health > 0
            and (rootPart.Position - pos).Magnitude <= 60 then
            result[#result + 1] = target
        end
    end
    return result
end

local function SourceTargetParts(targets)
    local result = {}
    for _, target in ipairs(targets) do
        local head = target:FindFirstChild("Head") or target.PrimaryPart
        if head then result[#result + 1] = {target, head} end
    end
    return result
end

local function ExecuteSourceFastAttack()
    if not _G.AutoLevel or not SourceFastAttack.Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local targets = SourceNearbyTargets(character, Enemies)
    if #targets < 1 then return end
    local targetParts = SourceTargetParts(targets)
    if #targetParts < 1 then return end

    local attackRemote = Net:FindFirstChild("RE/RegisterAttack")
    local hitRemote = Net:FindFirstChild("RE/RegisterHit")
    if not attackRemote or not hitRemote then return end

    attackRemote:FireServer(SourceFastAttack.Rate)
    hitRemote:FireServer(targetParts[1][2], targetParts)
end

local AttackRemoteTarget
local AttackRemoteId

local function InitializeHitRegistration()
    local folders = {
        ReplicatedStorage:FindFirstChild("Util"),
        ReplicatedStorage:FindFirstChild("Common"),
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("Assets"),
        ReplicatedStorage:FindFirstChild("FX"),
    }

    for _, folder in ipairs(folders) do
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                    AttackRemoteTarget = child
                    AttackRemoteId = child:GetAttribute("Id")
                end
            end

            folder.ChildAdded:Connect(function(child)
                if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                    AttackRemoteTarget = child
                    AttackRemoteId = child:GetAttribute("Id")
                end
            end)
        end
    end
end

InitializeHitRegistration()

local function ExecuteSourceHitRegistration()
    if not _G.AutoLevel then return end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root then return end

    local hitTargets = {}

    for _, target in ipairs(Enemies:GetChildren()) do
        local humanoid = target:FindFirstChild("Humanoid")
        local targetRoot = target:FindFirstChild("HumanoidRootPart")

        if humanoid and targetRoot and humanoid.Health > 0
            and target ~= character
            and (targetRoot.Position - root.Position).Magnitude <= 60 then

            for _, child in ipairs(target:GetChildren()) do
                if child:IsA("BasePart") then
                    hitTargets[#hitTargets + 1] = {target, child}
                end
            end
        end
    end

    local tool = character:FindFirstChildOfClass("Tool")
    if #hitTargets == 0 or not tool then return end

    local weaponType = tool:GetAttribute("WeaponType")
    if weaponType ~= "Melee" and weaponType ~= "Sword" then return end

    local seedRemote = Modules:FindFirstChild("Net")
        and Modules.Net:FindFirstChild("seed")

    local seed
    if seedRemote then
        pcall(function()
            seed = seedRemote:InvokeServer()
        end)
    end

    local attackRemote = Net:FindFirstChild("RE/RegisterAttack")
    local hitRemote = Net:FindFirstChild("RE/RegisterHit")
    if not attackRemote or not hitRemote then return end

    attackRemote:FireServer()

    local targetHead = hitTargets[1][1]:FindFirstChild("Head")
    if not targetHead then return end

    hitRemote:FireServer(targetHead, hitTargets, {})

    if AttackRemoteTarget and AttackRemoteId and seed
        and type(bit32) == "table" then

        local encryptionKey =
            math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1

        local encodedString = string.gsub("RE/RegisterHit", ".", function(char)
            return string.char(bit32.bxor(string.byte(char), encryptionKey))
        end)

        local finalId = bit32.bxor(AttackRemoteId + 909090, seed * 2)

        pcall(function()
            AttackRemoteTarget:FireServer(
                encodedString,
                finalId,
                targetHead,
                hitTargets
            )
        end)
    end
end

