-- Stable no-gravity state. Do not use VectorForce/BodyVelocity here:
-- those forces fight TweenTo and create an up/down oscillation.
local GravityForce = nil
local GravityAttachment = nil
local GravityRoot = nil

local function RestoreFarmGravity()
    if GravityForce then
        pcall(function() GravityForce:Destroy() end)
        GravityForce = nil
    end
    if GravityAttachment then
        pcall(function() GravityAttachment:Destroy() end)
        GravityAttachment = nil
    end
    GravityRoot = nil
end

local function DisableFarmGravity()
    local root = GetRoot()
    if not root then return end

    if GravityRoot == root and GravityForce and GravityForce.Parent then
        -- Keep exact anti-gravity force updated for the current assembly mass.
        GravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
        return
    end

    RestoreFarmGravity()
    GravityRoot = root

    GravityAttachment = Instance.new("Attachment")
    GravityAttachment.Name = "PhongdzFarmNoGravityAttachment"
    GravityAttachment.Parent = root

    GravityForce = Instance.new("VectorForce")
    GravityForce.Name = "PhongdzFarmNoGravity"
    GravityForce.Attachment0 = GravityAttachment
    GravityForce.RelativeTo = Enum.ActuatorRelativeTo.World
    GravityForce.ApplyAtCenterOfMass = true
    GravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
    GravityForce.Parent = root
end

