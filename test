Toggle.Activated:Connect(function()
    local nextState = not farmEnabled

    if nextState then
        if not farmLoaded then
            if not loadFarm() then
                farmEnabled = false
                _G.AutoLevel = false
                updateToggle()
                return
            end
        end

        -- Enable only after FARM_SOURCE has initialized.
        -- The Farm worker is persistent and will see this state immediately.
        _G.AutoLevel = true
        farmEnabled = true
        pcall(StartSourceMovement)
    else
        farmEnabled = false
        _G.AutoLevel = false
        pcall(StopSourceMovement)
    end

    updateToggle()
end)

