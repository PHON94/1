local function StopFarmTween()
    shouldTween = false
    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
        ActiveTween = nil
    end
end

-- Source movement controller: tween the invisible block and hand the
-- character to it inside the source's 200-stud range.
local function StartSourceMovement()
    if SourceMoveConnection then return end

    task.spawn(function()
        local character = LocalPlayer.Character
        while not character or not character.PrimaryPart do
            task.wait()
            character = LocalPlayer.Character
        end
        if character and character.PrimaryPart then
            block.CFrame = character.PrimaryPart.CFrame
        end
    end)

    SourceMoveConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local character = LocalPlayer.Character
            local primary = character and character.PrimaryPart
            if not character or not primary then return end

            if _G.AutoLevel and shouldTween then
                if block and block.Parent == workspace then
                    if (primary.Position - block.Position).Magnitude <= 200 then
                        primary.CFrame = block.CFrame
                    else
                        block.CFrame = primary.CFrame
                    end
                end

                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            else
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end)
    end)
end

local function StopSourceMovement()
    shouldTween = false
    StopFarmTween()
    if SourceMoveConnection then
        SourceMoveConnection:Disconnect()
        SourceMoveConnection = nil
    end
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function TweenTo(target)
    local gg
    if typeof(target) == "Vector3" then
        gg = CFrame.new(target)
    elseif typeof(target) == "CFrame" then
        gg = target
    elseif typeof(target) == "Instance" and target:IsA("BasePart") then
        gg = target.CFrame
    end
    if not gg then return end

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    StartSourceMovement()
    shouldTween = true

    local distance = (gg.Position - rootPart.Position).Magnitude
    local tweenInfo = TweenInfo.new(distance / 300, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(block, tweenInfo, {CFrame = gg})
    ActiveTween = tween

    if character:FindFirstChildOfClass("Humanoid")
        and character:FindFirstChildOfClass("Humanoid").Sit == true then
        block.CFrame = CFrame.new(block.Position.X, gg.Y, block.Position.Z)
    end

    tween.Completed:Connect(function()
        if ActiveTween == tween then ActiveTween = nil end
    end)
    tween:Play()
    return tween
end

