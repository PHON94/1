-- 🚀 THUẬT TOÁN TRUE HYBRID AI (FILE 1 + FILE 2)
--------------------------------------------------------------------------------
local function pickBestColorTrueHybrid()
	local n = #history
	if n == 0 then
		return COLOR_ORDER[math.random(#COLOR_ORDER)], 50
	end

	local f, ftot = {}, 6
	local o1, o1tot = {}, 6
	local o2, o2tot = {}, 6
	for _, c in ipairs(COLOR_ORDER) do f[c], o1[c], o2[c] = 1, 1, 1 end

	for i = 1, n do
		local entryPicks = history[i].picks
		for j = 1, 4 do
			local c = entryPicks[j]
			if c and f[c] then
				local w = 0.97 ^ (n - i)
				f[c] = f[c] + w
				ftot = ftot + w
			end
		end
	end

	local lastPickedColor = history[n].picks[4]
	local prevPickedColor = (n >= 2) and history[n - 1].picks[4] or nil

	for i = 2, n do
		local curr = history[i].picks[4]
		local prev = history[i - 1].picks[4]
		local prev2 = (i >= 3) and history[i - 2].picks[4] or nil

		if prev == lastPickedColor and o1[curr] then
			o1[curr] = o1[curr] + 1
			o1tot = o1tot + 1
		end

		if prev2 and prev2 == prevPickedColor and prev == lastPickedColor and o2[curr] then
			o2[curr] = o2[curr] + 1
			o2tot = o2tot + 1
		end
	end

	local counts, streaks = {}, {}
	for _, c in ipairs(COLOR_ORDER) do counts[c] = 0; streaks[c] = 0 end
	
	for _, entry in ipairs(history) do
		for j = 1, 4 do 
			if entry.picks[j] then 
				counts[entry.picks[j]] = counts[entry.picks[j]] + 1 
			end 
		end
	end
	
	for _, c in ipairs(COLOR_ORDER) do
		for i = n, 1, -1 do
			local present = false
			for j = 1, 4 do if history[i].picks[j] == c then present = true break end end
			if not present then streaks[c] = streaks[c] + 1 else break end
		end
	end

	local bestColor, bestScore = COLOR_ORDER[1], -9999
	
	for _, c in ipairs(COLOR_ORDER) do
		local scoreFile1 = 0.3 * (f[c] / ftot) + 0.3 * (o1[c] / o1tot) + 0.4 * (o2[c] / o2tot)
		local scoreFile2 = (streaks[c] * 0.2) + (1 / (1 + counts[c]))
		
		local finalScore = (scoreFile1 * 0.7) + (scoreFile2 * 0.3)
		
		if finalScore > bestScore then
			bestScore = finalScore
			bestColor = c
		end
	end

	local confidence = math.clamp(math.floor(bestScore * 180 + 40), 45, 96)
	return bestColor, confidence
end

