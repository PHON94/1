--------------------------------------------------------------------------------
local function setPrediction(colorName, conf, statusText)
	PP_Color.Text = colorName
	PP_Color.TextColor3 = COLORS[colorName] or Color3.new(1, 1, 1)
	PP_Question.Visible = false
	PP_Dot.Visible = true 
	PP_Box.BackgroundColor3 = COLORS[colorName] or Color3.fromRGB(42, 36, 54)
	PP_Conf.Text = tostring(conf) .. "%"
	PP_Status.Text = statusText
	
	local c = Color3.fromRGB(110, 220, 145)
	if conf < 55 then c = Color3.fromRGB(220, 110, 110)
	elseif conf < 70 then c = Color3.fromRGB(220, 200, 100) end
	
	PP_Conf.TextColor3 = c
	PP_BarFill.BackgroundColor3 = c
	TweenService:Create(PP_BarFill, TweenInfo.new(0.4), {Size = UDim2.new(conf / 100, 0, 1, 0)}):Play()
end

local function updateHitRate()
	local total = hits + misses
	if total == 0 then
		HR_Value.Text = "—"
		HR_Sub.Text = "No results yet"
		HR_BarFill.Size = UDim2.new(0.5, 0, 1, 0)
		return
	end
	local rate = hits / total
	HR_Value.Text = string.format("%.1f%%", rate * 100)
	HR_Sub.Text = string.format("%d / %d hits • streak %d", hits, total, streak)
	TweenService:Create(HR_BarFill, TweenInfo.new(0.4), {Size = UDim2.new(rate, 0, 1, 0)}):Play()
end

local function doPredict()
	if isCooldownActive then return end

	local picks = {}
	for i = 1, 4 do picks[i] = diceColors[i] end

	local entry = {picks = picks, result = "PENDING", confidence = 0}
	
	local chosen, conf = pickBestColorTrueHybrid()
	table.insert(history, entry)
	rollsObserved = rollsObserved + 1

	entry.prediction = chosen
	entry.confidence = conf
	setPrediction(chosen, conf, string.format("True Hybrid (%d rolls)", #history))

	local hit = false
	for i = 1, 4 do if picks[i] == chosen then hit = true break end end
	if #history == 1 then hit = true end

	if hit then
		entry.result = "HIT"
		hits = hits + 1
		streak = streak + 1
	else
		entry.result = "MISS"
		misses = misses + 1
		streak = 0
	end

	updateHitRate()
	Footer.Text = string.format("Rolls %d • Next #%d • Bet %d", rollsObserved, rollsObserved + 1, betAmount)
end

PredictBtn.MouseButton1Click:Connect(doPredict)

