    })
    round(historyList, 8); outline(historyList)
    make("UIPadding", historyList, {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
    })
    make("UIListLayout", historyList, {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})

    local history = {}
    local countLabel -- assigned below with the right panel

    local function updateCount()
        if countLabel then countLabel.Text = #history .. " saved" end
    end

    local function renderHistory()
        for _, c in ipairs(historyList:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
        end
        if #history == 0 then
            make("TextLabel", historyList, {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24),
                Text = "No predictions yet", TextColor3 = GREY,
                Font = Enum.Font.Gotham, TextSize = 9,
                TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1,
            })
            historyList.CanvasSize = UDim2.fromOffset(0, 30)
            return
        end
        for i = #history, 1, -1 do
            local e = history[i]
            local row = make("Frame", historyList, {
                Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = BTN,
                BorderSizePixel = 0, LayoutOrder = #history - i, ZIndex = 4,
            })
            round(row, 6)
            text(row, e.Time, 7, UDim2.fromOffset(4, 0), UDim2.fromOffset(28, 24), GREY)
            for d, name in ipairs(e.Inputs) do
                local c = colorByName(name)
                local dot = make("Frame", row, {
                    Position = UDim2.fromOffset(34 + (d - 1) * 7, 9),
                    Size = UDim2.fromOffset(6, 6),
                    BackgroundColor3 = c.Color, BorderSizePixel = 0, ZIndex = 5,
                })
                round(dot, 6)
            end
            text(row, "→", 9, UDim2.fromOffset(78, 0), UDim2.fromOffset(10, 24), GREY)
            local pdot = make("Frame", row, {
                Position = UDim2.fromOffset(90, 9), Size = UDim2.fromOffset(6, 6),
                BackgroundColor3 = e.Color, BorderSizePixel = 0, ZIndex = 5,
            })
            round(pdot, 6)
            text(row, e.Name, 8, UDim2.fromOffset(100, 0), UDim2.fromOffset(38, 24), e.Color)
            local conf = text(row, e.Confidence .. "%", 8, UDim2.new(1, -30, 0, 0), UDim2.fromOffset(28, 24), GREY)
            conf.TextXAlignment = Enum.TextXAlignment.Right
        end
        historyList.CanvasSize = UDim2.fromOffset(0, #history * 28 + 8)
    end
    clearBtn.MouseButton1Click:Connect(function() history = {}; renderHistory(); updateCount() end)
    renderHistory()

    -- RIGHT: HISTORY BUTTON (where status used to be)
    local right = make("Frame", main, {
        Position = UDim2.fromOffset(268, BODY_Y), Size = UDim2.fromOffset(64, BODY_H),
        BackgroundColor3 = PANEL, BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 2,
    })
    round(right, 10); outline(right)

    local historyBtn = make("TextButton", right, {
