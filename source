    })
    round(historyBtn, 8); outline(historyBtn)

    local historyIcon = make("TextLabel", historyBtn, {
        BackgroundTransparency = 1, Text = "📜", TextColor3 = WHITE,
        Font = Enum.Font.GothamBold, TextSize = 22,
        Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 28),
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4,
    })
    local historyName = make("TextLabel", historyBtn, {
        BackgroundTransparency = 1, Text = "HISTORY", TextColor3 = WHITE,
        Font = Enum.Font.GothamBlack, TextSize = 9,
        Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 12),
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4,
    })
    countLabel = make("TextLabel", historyBtn, {
        BackgroundTransparency = 1, Text = "0 saved", TextColor3 = GREY,
        Font = Enum.Font.GothamBold, TextSize = 8,
        Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 10),
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4,
    })

    historyBtn.MouseEnter:Connect(function() tween(historyBtn, {BackgroundColor3 = Color3.fromRGB(43, 42, 51)}) end)
    historyBtn.MouseLeave:Connect(function() tween(historyBtn, {BackgroundColor3 = BTN}) end)

    local showingHistory = false
    historyBtn.MouseButton1Click:Connect(function()
        showingHistory = not showingHistory
        predictView.Visible = not showingHistory
        historyView.Visible = showingHistory
        historyIcon.Text = showingHistory and "↩" or "📜"
        historyName.Text = showingHistory and "BACK" or "HISTORY"
        if showingHistory then renderHistory() end
    end)

    log("4: UI complete")

    -- PREDICTION
    local predictRemote = ReplicatedStorage:FindFirstChild("PredictDice")
    local predicting = false

    local function requestPrediction(pool)
        if predictRemote and predictRemote:IsA("RemoteFunction") then
            local ok2, res = pcall(function() return predictRemote:InvokeServer(pool) end)
            if ok2 and type(res) == "table" and type(res.Color) == "string" then
                for _, n in ipairs(pool) do
                    if n == res.Color then
                        return {Color = res.Color, Confidence = tonumber(res.Confidence) or math.random(75, 99)}
                    end
                end
            end
        end
        return {Color = pool[math.random(#pool)], Confidence = math.random(75, 99)}
    end

    local function doPredict()
        if predicting then return end
        local pool, seen, inputs = {}, {}, {}
        for _, slot in ipairs(slots) do
            local name = COLORS[slot.colorIndex].Name
            table.insert(inputs, name)
            if not seen[name] then seen[name] = true; table.insert(pool, name) end
        end
        if #pool == 0 then return end

        predicting = true
        setActive(true)
        predictBtn.Text = "PREDICTING"
        predictBtn.BackgroundColor3 = GREY
        predictBtn.TextColor3 = WHITE
        resultText.Text = "Predicting..."
        resultText.TextColor3 = GREY
        confidenceLabel.Text = "CONFIDENCE -"
        resultDot.BackgroundColor3 = GREY

        task.wait(0.7)

        local res = requestPrediction(pool)
        local data = colorByName(res.Color)
        local conf = math.clamp(math.floor(res.Confidence + 0.5), 1, 99)
        resultDot.BackgroundColor3 = data.Color
        resultText.Text = data.Name
        resultText.TextColor3 = data.Color
        confidenceLabel.Text = "CONFIDENCE " .. conf .. "%"
        table.insert(history, {
            Time = os.date("%H:%M"), Inputs = inputs,
            Name = data.Name, Color = data.Color, Confidence = conf,
        })
        updateCount()
        if showingHistory then renderHistory() end
        if diceSound then pcall(function() diceSound:Play() end) end
        setActive(false)
        predictBtn.Text = "PREDICT"
        predictBtn.BackgroundColor3 = WHITE
        predictBtn.TextColor3 = BG
        predicting = false
    end

    predictBtn.MouseButton1Click:Connect(doPredict)
    setActive(false)
    log("5: ready")
end)

if not ok then
    warn("[WD] FAILED: " .. tostring(err))
end
