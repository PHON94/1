    }

    local function colorByName(name)
        for _, c in ipairs(COLORS) do
            if c.Name == name then return c end
        end
        return COLORS[1]
    end

    local function make(class, parent, props)
        local obj = Instance.new(class)
        for k, v in pairs(props) do obj[k] = v end
        obj.Parent = parent
        return obj
    end
    local function round(obj, size) return make("UICorner", obj, {CornerRadius = UDim.new(0, size)}) end
    local function outline(obj, color, thickness)
        return make("UIStroke", obj, {Color = color or BORDER, Thickness = thickness or 1.2})
    end
    local function text(parent, value, size, pos, dim, color, font)
        return make("TextLabel", parent, {
            BackgroundTransparency = 1, Text = value,
            TextColor3 = color or WHITE, Font = font or Enum.Font.GothamBold,
            TextSize = size, Position = pos, Size = dim,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
    end
    local function tween(obj, props, t)
        TweenService:Create(obj, TweenInfo.new(t or 0.12), props):Play()
    end

    local dragConns = {}
    local function makeDraggable(frame, handle)
        local dragging, dragStart, startPosition
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPosition = frame.Position
            end
        end)
        table.insert(dragConns, UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(
                    startPosition.X.Scale, startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
            end
        end))
        table.insert(dragConns, UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end))
    end
    gui.Destroying:Connect(function()
        for _, c in ipairs(dragConns) do c:Disconnect() end
    end)

    -- dice sound (isolated so a bad ID can't kill the UI)
