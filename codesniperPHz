-- ===================== CORE: REMOTE LIMITER (token bucket) =====================
-- Refills at MaxPPS, holds up to BurstLimit. No lockout window, so normal play
-- is never blocked. Only FireServer is limited (dropping an InvokeServer would
-- return nil and break game scripts). Your own executor calls are never touched.
-- one bucket per remote, so spam on one remote never starves the others.
-- Whitelisted remotes (by name) are never limited. Every FireServer is also
-- counted so the REMOTE tab can show what your game sends.
local buckets = setmetatable({}, { __mode = "k" })
local isOwnCall = checkcaller or function() return false end

local remoteStats = {} -- [remote name] = { n, rate, limited, last }

local function statFor(name)
    local st = remoteStats[name]
    if not st then
        st = { n = 0, rate = 0, limited = 0, last = 0 }
        remoteStats[name] = st
    end
    return st
end

for name in pairs(state.whitelist) do
    statFor(name)
end

local function shouldAllow(now, remote, st)
    if not state.Enabled then return true end

    local b = buckets[remote]
    if not b then
        b = { tokens = state.BurstLimit, last = now }
        buckets[remote] = b
    end

    local elapsed = now - b.last
    b.last = now
    b.tokens = math.min(state.BurstLimit, b.tokens + elapsed * state.MaxPPS)

    if b.tokens >= 1 then
        b.tokens -= 1
        return true
    end

    state.totalDropped += 1
    st.limited += 1
    if state.Log then
        warn("[Xefew] Remote call limited: " .. tostring(remote))
    end
    return false
end

local oldNamecall
local function hookFn(self, ...)
    if getnamecallmethod() == "FireServer" and not isOwnCall() then
        local name = self.Name
        local st = remoteStats[name] or statFor(name)
        st.n += 1
        if not state.whitelist[name] and not shouldAllow(tick(), self, st) then
            return
        end
    end
    return oldNamecall(self, ...)
end

state.hookOk = pcall(function()
    if hookmetamethod then
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(hookFn))
    else
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(hookFn)
        setreadonly(mt, true)
    end
end)

if not state.hookOk then
    warn("[Xefew] Remote hook failed - limiter off, lag detector still running")
end

-- calls per second for each remote
local rateLast = tick()
RunService.Heartbeat:Connect(function()
    local now = tick()
    local el = now - rateLast
    if el >= 1 then
        rateLast = now
        for _, st in pairs(remoteStats) do
            st.rate = math.floor((st.n - st.last) / el + 0.5)
            st.last = st.n
        end
    end
end)

