local function buildLog(page)
    local listFrame = make("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 320),
        BackgroundColor3 = CARD,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
