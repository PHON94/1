            row.wl.BackgroundColor3 = on and accent or Color3.fromRGB(50, 50, 64)
            row.wl.TextColor3 = on and Color3.new(1, 1, 1) or MUTED
            row.frame.LayoutOrder = -(st.rate * 1000 + math.min(st.limited, 999))
        end
        emptyLbl.Visible = (count == 0)
    end
end

