task.spawn(function()
    while gui.Parent do
        local ok, ping = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and ping then
            PingLabel.Text = string.format("Ping: %d ms", math.floor(ping))
            if ping > 300 then
