            elseif ping > 150 then
                PingLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
            else
                PingLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
            end
        end
        task.wait(0.5)
    end
end)

