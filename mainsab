--==================================================
-- ESP ENGINE
--==================================================

local ESPFolder = Create("Folder", {
    Name = "PhongHubESP",
}, Workspace)

local ESPObjects = {}

local function DestroyESP(key)
    local data = ESPObjects[key]
    if not data then
        return
    end

    if data.Highlight then
        pcall(function()
            data.Highlight:Destroy()
        end)
    end

    if data.Billboard then
        pcall(function()
            data.Billboard:Destroy()
        end)
    end

    ESPObjects[key] = nil
end

local function ClearESP()
    for key in pairs(ESPObjects) do
        DestroyESP(key)
    end
end

local function GetAdornee(model)
    if not model then
        return nil
    end

    if model:IsA("BasePart") then
        return model
    end

    if model:IsA("Model") then
        return model.PrimaryPart
            or model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function GetObjectPosition(model, adornee)
    if model and model:IsA("Model") then
        local success, pivot = pcall(function()
            return model:GetPivot()
        end)

        if success then
            return pivot.Position
        end
    end

    return adornee and adornee.Position or nil
end

local function CreateESP(key, model, adornee, color)
    local data = ESPObjects[key]

    if data and (
        data.Model ~= model
        or data.Adornee ~= adornee
    ) then
        DestroyESP(key)
        data = nil
    end

    if not data then
        local highlight = Create("Highlight", {
            Name = "PhongHubHighlight",
            Adornee = model,
            Enabled = true,
            FillColor = color,
            OutlineColor = color,
            FillTransparency = 1,
            OutlineTransparency = 0,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        }, ESPFolder)

        local billboard = Create("BillboardGui", {
            Name = "PhongHubLabel",
            Adornee = adornee,
            AlwaysOnTop = true,
            LightInfluence = 0,
            MaxDistance = 2500,
            Size = UDim2.fromOffset(190, 42),
            StudsOffset = Vector3.new(0, 3.1, 0),
            Enabled = true,
        }, Gui)

        local label = Create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = color,
            TextStrokeColor3 = Color3.new(0, 0, 0),
            TextStrokeTransparency = 0.15,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Bottom,
        }, billboard)

        data = {
            Model = model,
            Adornee = adornee,
            Highlight = highlight,
            Billboard = billboard,
            Label = label,
        }

        ESPObjects[key] = data
    end

    data.Highlight.Adornee = model
    data.Billboard.Adornee = adornee

    return data
end

local function PaintESP(data, color, text, boxEnabled, chamsEnabled)
    data.Highlight.FillColor = color
    data.Highlight.OutlineColor = color
    data.Highlight.OutlineTransparency = boxEnabled and 0 or 1
    data.Highlight.FillTransparency = chamsEnabled and 0.68 or 1
    data.Highlight.Enabled = boxEnabled or chamsEnabled

    data.Label.TextColor3 = color
    data.Label.Text = text
    data.Billboard.Enabled = text ~= ""
end

