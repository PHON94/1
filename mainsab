    Corner(row, 7)

    MakeLabel(
        row,
        title,
        UDim2.new(1, -125, 1, 0),
        UDim2.fromOffset(10, 0),
        11,
        COLORS.Text,
        true
    )

    local valueLabel = MakeLabel(
        row,
        tostring(Config[configKey]),
        UDim2.fromOffset(112, 25),
        UDim2.new(1, -120, 0.5, -12),
        9,
        COLORS.Accent,
        true
    )
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local function refresh()
        valueLabel.Text = tostring(Config[configKey])
    end

    row.MouseEnter:Connect(function()
        Tween(row, { BackgroundColor3 = COLORS.RowHover }, 0.12)
    end)
    row.MouseLeave:Connect(function()
        Tween(row, { BackgroundColor3 = COLORS.Row }, 0.12)
    end)
    row.MouseButton1Click:Connect(function()
        local currentIndex = table.find(options, Config[configKey]) or 0
        currentIndex += 1
        if currentIndex > #options then currentIndex = 1 end
        Config[configKey] = options[currentIndex]
        refresh()
    end)

    return refresh
end

