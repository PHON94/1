-- CHARACTER

local function GetRoot()
    local character = Player.Character
    if not character then return nil end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
end


-- ANTI BAT GUARD (adapted from the supplied Slaxer source)
-- No remote loader, no hidden HttpGet, and no external code execution.
local SAFE_GUARD = {
    SpikeDelta = 110,
    MaxFrameDelta = 0.2,
    MaxVerticalAfterHit = 80,
    RecoverRagdoll = true
}

local antiBatConnection = nil
local lastAntiBatVelocity = Vector3.new(0, 0, 0)

local function GetHumanoid()
    local character = Player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetVelocity(root)
    local ok, velocity = pcall(function()
        return root.AssemblyLinearVelocity
    end)
    if ok and typeof(velocity) == "Vector3" then
        return velocity
    end
    return root.Velocity
end

local function SetVelocity(root, velocity)
    local ok = pcall(function()
        root.AssemblyLinearVelocity = velocity
    end)
    if not ok then
        pcall(function()
            root.Velocity = velocity
        end)
    end
end

local function SetAngularVelocity(root, velocity)
    local ok = pcall(function()
        root.AssemblyAngularVelocity = velocity
    end)
    if not ok then
        pcall(function()
            root.RotVelocity = velocity
        end)
    end
end

local function IsRagdollState(humanoid)
    local state = humanoid:GetState()
    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
end

local function ReenableMotors(character)
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("Motor6D") and not item.Enabled then
            item.Enabled = true
        end
    end
end

local function EnablePlayerControls()
    pcall(function()
        local scripts = Player:FindFirstChild("PlayerScripts")
        local module = scripts and scripts:FindFirstChild("PlayerModule")
        local controls = module and module:FindFirstChild("ControlModule")
        if controls then
            require(controls):Enable()
        end
    end)
end

local function AntiBatStep(dt)
    if not Config.AntiBat then return end

    local character = Player.Character
    local humanoid = GetHumanoid()
    local root = GetRoot()

    if not character or not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    local velocity = GetVelocity(root)
    local velocityDelta = (velocity - lastAntiBatVelocity).Magnitude
    local ragdolled = IsRagdollState(humanoid)
    local suddenHit = velocityDelta > SAFE_GUARD.SpikeDelta
        and dt > 0
        and dt < SAFE_GUARD.MaxFrameDelta

    if ragdolled and SAFE_GUARD.RecoverRagdoll then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end)

        local camera = workspace.CurrentCamera
        if camera then
            camera.CameraSubject = humanoid
        end

        EnablePlayerControls()
        SetVelocity(root, Vector3.zero)
        SetAngularVelocity(root, Vector3.zero)
        ReenableMotors(character)

    elseif suddenHit then
        -- Keep normal movement input while limiting an abnormal launch.
        local intended = humanoid.MoveDirection * humanoid.WalkSpeed
        local safeY = math.clamp(
            velocity.Y,
            -SAFE_GUARD.MaxVerticalAfterHit,
            SAFE_GUARD.MaxVerticalAfterHit
        )

        SetVelocity(root, Vector3.new(intended.X, safeY, intended.Z))
        SetAngularVelocity(root, Vector3.zero)
    end

    lastAntiBatVelocity = GetVelocity(root)
end

local function StartAntiBat()
    if antiBatConnection then return end

    local root = GetRoot()
    lastAntiBatVelocity = root and GetVelocity(root) or Vector3.zero
    antiBatConnection = RunService.Heartbeat:Connect(AntiBatStep)
end

local function StopAntiBat()
    if antiBatConnection then
        antiBatConnection:Disconnect()
        antiBatConnection = nil
    end
end

