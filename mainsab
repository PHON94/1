local function GetPodiumModel(podium)
    if podium:IsA("Model") then
        return podium
    end

    local nestedModel = podium:FindFirstChildWhichIsA("Model", true)
    if nestedModel then
        return nestedModel
    end

    return podium
end

local function UpdateBrainrotESP(alive)
    if not Config.BrainrotESP then
        return
    end

    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return
