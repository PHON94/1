local function runAdminCommand(command, target)
    local gui, panel = adminPanel()
    if not (gui and panel and target) then return false end
    local commandButton
    for _, button in ipairs(panel:GetDescendants()) do
        if button:IsA("GuiButton") and button.Name ~= "Template" then
            local label = button:FindFirstChild("Command")
            if label and label:IsA("TextLabel")
                and label.Text:lower():gsub("^;", "") == command then
                commandButton = button
                break
            end
        end
    end
    if not commandButton then return false end
    local timer = commandButton:FindFirstChild("Timer")
    if timer and timer:IsA("TextLabel") and timer.Visible then
        local cooldown = tonumber(timer.Text:match("(%d+)")) or 0
        if cooldown > 0 then return false end
    end

    local wasVisible = panel.Visible
    panel.Visible = true
    pressGuiButton(commandButton)
    task.wait(0.15)
    local selected = false
    for _, button in ipairs(gui:GetDescendants()) do
        if button:IsA("GuiButton") and button.Visible and button ~= commandButton then
            local hit = button.Name == target.Name or button.Name == tostring(target.UserId)
            if not hit then
                for _, label in ipairs(button:GetDescendants()) do
                    if label:IsA("TextLabel") and (
                        label.Text == target.Name or label.Text == target.DisplayName
                        or label.Text == "@" .. target.Name
                    ) then
                        hit = true
                        break
                    end
                end
            end
            if hit then
                pressGuiButton(button)
                selected = true
                break
            end
        end
    end
    panel.Visible = wasVisible
    return selected
end

