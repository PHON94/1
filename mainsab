                                and descendant.Visible
                                and descendant.Text ~= "" then
                                displayName = descendant.Text
                                break
                            end
                        end

                        lines[#lines + 1] = displayName
                    end

                    if Config.BrainrotDistance and myRoot and position then
                        local distance = math.floor(
                            (position - myRoot.Position).Magnitude
                        )
