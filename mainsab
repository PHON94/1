local function RemovePlayerVisual(player)
    local entry = playerVisuals[player]
    if not entry then return end
    for _, object in pairs(entry) do
        pcall(function()
            if object and object.Remove then object:Remove() else object:Destroy() end
        end)
    end
    playerVisuals[player] = nil
end

local function MakePlayerVisual(player)
    if player == Player or playerVisuals[player] then return end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not humanoid then return end

    local entry = {}

    local highlight = Instance.new("Highlight")
    highlight.Name = "KeepMainPlayerHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(0, 170, 255)
    highlight.OutlineColor = Color3.fromRGB(220, 245, 255)
    highlight.FillTransparency = 0.78
    highlight.OutlineTransparency = 0.05
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = Gui
    entry.highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KeepMainPlayerInfo"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(150, 42)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = Gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.25
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextWrapped = true
    label.Parent = billboard
    entry.billboard = billboard
    entry.label = label

    if drawingAvailable then
        pcall(function()
            local line = Drawing.new("Line")
            line.Thickness = 1.5
            line.Color = Color3.fromRGB(0, 190, 255)
            line.Visible = false
            entry.tracer = line
        end)
    end

    playerVisuals[player] = entry
end

local function ClearObjectVisual(key)
    local item = objectVisuals[key]
    if not item then return end
    pcall(function()
        if item.highlight then item.highlight:Destroy() end
        if item.billboard then item.billboard:Destroy() end
    end)
    objectVisuals[key] = nil
end

local function IsVisualTarget(name, mode)
    local lower = string.lower(name or "")
    if mode == "Delivery" then
        return lower:find("deliver") or lower:find("truck") or lower:find("dropoff")
    elseif mode == "Clone" then
        return lower:find("clone") or lower:find("copy")
    elseif mode == "Mine" then
        return lower:find("mine") or lower:find("mining")
    elseif mode == "Timer" then
        return lower:find("timer") or lower:find("cooldown") or lower:find("countdown")
    end
    return false
end

local function GetAdornee(instance)
    if instance:IsA("BasePart") then return instance end
    if instance:IsA("Model") then
        return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return instance:FindFirstAncestorWhichIsA("Model")
        and (instance:FindFirstAncestorWhichIsA("Model").PrimaryPart
        or instance:FindFirstAncestorWhichIsA("Model"):FindFirstChildWhichIsA("BasePart", true))
end

local function AddObjectVisual(instance, key, labelText, color)
    if objectVisuals[key] then return end
    local adornee = GetAdornee(instance)
    if not adornee then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "KeepMainWorldHighlight"
    highlight.Adornee = instance:IsA("Model") and instance or adornee
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.82
    highlight.OutlineTransparency = 0.08
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = Gui

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KeepMainWorldLabel"
    billboard.Adornee = adornee
    billboard.Size = UDim2.fromOffset(130, 26)
    billboard.StudsOffset = Vector3.new(0, 2.4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = Gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.Parent = billboard

    objectVisuals[key] = {highlight = highlight, billboard = billboard}
end

local function ScanWorldVisuals()
    local plots = workspace:FindFirstChild("Plots")

    if Config.Visuals.BaseESP and plots then
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            local basePart = plot:FindFirstChildWhichIsA("BasePart", true)
            if sign and basePart then
                local key = "base_" .. plot:GetFullName()
                AddObjectVisual(plot, key, "BASE", Color3.fromRGB(70, 180, 255))
            end
        end
    end

    local modes = {
        {key = "TimerESP", name = "Timer", color = Color3.fromRGB(255, 205, 75)},
        {key = "DeliveryESP", name = "Delivery", color = Color3.fromRGB(90, 220, 150)},
        {key = "CloneESP", name = "Clone", color = Color3.fromRGB(190, 120, 255)},
        {key = "MineESP", name = "Mine", color = Color3.fromRGB(255, 120, 100)}
    }

    for _, mode in ipairs(modes) do
        if Config.Visuals[mode.key] then
            for _, item in ipairs(workspace:GetDescendants()) do
                if item ~= workspace and IsVisualTarget(item.Name, mode.name) then
                    local key = mode.name .. "_" .. item:GetFullName()
                    AddObjectVisual(item, key, mode.name:upper(), mode.color)
                end
            end
        end
    end

    -- Remove stale world markers when a feature is disabled.
    for key, item in pairs(objectVisuals) do
        local keep = false
        if key:sub(1, 5) == "base_" then
            keep = Config.Visuals.BaseESP
        else
            local prefix = key:match("^([^_]+)_")
            keep = (prefix == "Timer" and Config.Visuals.TimerESP)
                or (prefix == "Delivery" and Config.Visuals.DeliveryESP)
                or (prefix == "Clone" and Config.Visuals.CloneESP)
                or (prefix == "Mine" and Config.Visuals.MineESP)
        end
        if not keep then ClearObjectVisual(key) end
    end
end

local visualScanClock = 0
visualsConnection = RunService.RenderStepped:Connect(function(dt)
    local anyPlayerFeature = Config.Visuals.PlayerESP
        or Config.Visuals.PlayerBox or Config.Visuals.PlayerTracer

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            if anyPlayerFeature then
                MakePlayerVisual(target)
            end

            local entry = playerVisuals[target]
            local character = target.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local active = anyPlayerFeature and root and humanoid and humanoid.Health > 0

            if entry then
                if entry.highlight then
                    entry.highlight.Adornee = character
                    entry.highlight.Enabled = active and (Config.Visuals.PlayerESP or Config.Visuals.PlayerBox)
                end
                if entry.billboard then
                    entry.billboard.Adornee = root
                    entry.billboard.Enabled = active and Config.Visuals.PlayerESP
                    if active then
                        local bits = {}
                        if Config.Visuals.PlayerName then table.insert(bits, target.DisplayName) end
                        if Config.Visuals.PlayerDistance then
                            local myRoot = GetRoot()
                            if myRoot then
                                table.insert(bits, tostring(math.floor((root.Position - myRoot.Position).Magnitude)) .. "m")
                            end
                        end
                        if Config.Visuals.PlayerHealth then
                            table.insert(bits, "HP " .. tostring(math.floor(humanoid.Health)))
                        end
                        entry.label.Text = table.concat(bits, "  |  ")
                    end
                end
                if entry.tracer then
                    local camera = workspace.CurrentCamera
                    local point, onScreen = camera:WorldToViewportPoint(root.Position)
                    entry.tracer.Visible = active and Config.Visuals.PlayerTracer and onScreen
                    if entry.tracer.Visible then
                        local viewport = camera.ViewportSize
                        entry.tracer.From = Vector2.new(viewport.X / 2, viewport.Y - 8)
                        entry.tracer.To = Vector2.new(point.X, point.Y)
                    end
                end
            end
        end
    end

    for target in pairs(playerVisuals) do
        if not target.Parent then RemovePlayerVisual(target) end
    end

    visualScanClock = visualScanClock + dt
    if visualScanClock >= 1.5 then
        visualScanClock = 0
        pcall(ScanWorldVisuals)
    end
end)

