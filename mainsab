local function UpdatePlayerESP(alive)
    if not Config.PlayerESP then
        return
    end

    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= LocalPlayer then
            local character = target.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if character and root then
                local key = "Player_" .. tostring(target.UserId)
                alive[key] = true

                local color = Color3.fromRGB(245, 245, 255)
                local lines = {}

                if Config.PlayerName then
                    lines[#lines + 1] = target.DisplayName or target.Name
                end

                if Config.PlayerDistance and myRoot then
                    local distance = math.floor(
                        (root.Position - myRoot.Position).Magnitude
                    )
                    lines[#lines + 1] = tostring(distance) .. "m"
                end

                local data = CreateESP(
                    key,
                    character,
                    root,
                    color
                )

                PaintESP(
                    data,
                    color,
                    table.concat(lines, "\n"),
                    Config.PlayerBox,
                    Config.PlayerChams
                )
            end
        end
    end
end

