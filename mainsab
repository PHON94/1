local function getAimPart(character)
    if not character then return nil end

    local preferred = Config.AimTargetPart
    local part = character:FindFirstChild(preferred)
    if part and part:IsA("BasePart") then
        return part
    end

    local fallback = character:FindFirstChild("HumanoidRootPart")
    if fallback and fallback:IsA("BasePart") then
        return fallback
    end
    return character:FindFirstChildWhichIsA("BasePart")
end

local function isAimTargetVisible(camera, targetCharacter, targetPart)
    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin
    if direction.Magnitude <= 0 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }

    local result = Workspace:Raycast(origin, direction, params)
    return result == nil or result.Instance:IsDescendantOf(targetCharacter)
end

