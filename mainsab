                        color,
                        table.concat(lines, "\n"),
                        Config.BrainrotBox,
                        Config.BrainrotChams
                    )
                end
            end
        end
    end
end

--==================================================
-- X-RAY ENGINE
--==================================================

local XrayOriginals = {}

local function IsMyPlot(plot)
    local sign = plot:FindFirstChild("PlotSign")
    local yourBase = sign and sign:FindFirstChild("YourBase")

    return yourBase
        and yourBase:IsA("BillboardGui")
        and yourBase.Enabled
end

local function RestoreXray()
    for part, oldValue in pairs(XrayOriginals) do
        if part and part.Parent then
            pcall(function()
                part.LocalTransparencyModifier = oldValue
            end)
        end

        XrayOriginals[part] = nil
    end
end

local function UpdateXray()
    if not Config.Xray then
        if next(XrayOriginals) then
            RestoreXray()
        end
        return
    end

    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return
    end

    local currentParts = {}

    for _, plot in ipairs(plots:GetChildren()) do
        if not IsMyPlot(plot) then
            local podiums = plot:FindFirstChild("AnimalPodiums")

            for _, part in ipairs(plot:GetDescendants()) do
                if part:IsA("BasePart")
                    and part.Transparency < 1
                    and part.Name ~= "Spawn"
                    and not (podiums and part:IsDescendantOf(podiums)) then

                    currentParts[part] = true

                    if XrayOriginals[part] == nil then
                        XrayOriginals[part] = part.LocalTransparencyModifier
                    end

                    part.LocalTransparencyModifier = Config.XrayTransparency
                end
            end
        end
    end

    -- Restore parts that are no longer inside an enemy plot.
    for part, oldValue in pairs(XrayOriginals) do
        if not currentParts[part] then
            if part and part.Parent then
                pcall(function()
                    part.LocalTransparencyModifier = oldValue
                end)
            end

            XrayOriginals[part] = nil
        end
    end
end

