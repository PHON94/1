-- OWN PLOT CHECK

local function IsMyPlot(plot)
    local sign = plot:FindFirstChild("PlotSign")
    local yourBase = sign and sign:FindFirstChild("YourBase")

    return yourBase
        and yourBase:IsA("BillboardGui")
        and yourBase.Enabled
end

-- PROMPT POSITION

local function GetPromptPosition(prompt)
    local parent = prompt.Parent

    while parent and parent ~= workspace do
        if parent:IsA("BasePart") then
            return parent.Position
        end

        parent = parent.Parent
    end

    return nil
end

-- FIND NEAREST PROMPT

local function FindNearestPrompt()
    local root = GetRoot()
    if not root then return nil end

    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local nearest = nil
    local nearestDistance = math.huge

    for _, plot in ipairs(plots:GetChildren()) do
        if IsMyPlot(plot) then
            continue
        end

        local podiums = plot:FindFirstChild("AnimalPodiums")
        if not podiums then continue end

        for _, podium in ipairs(podiums:GetChildren()) do
            local base = podium:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            local attachment = spawn and spawn:FindFirstChild("PromptAttachment")

            if not attachment then continue end

            for _, prompt in ipairs(attachment:GetChildren()) do
                if prompt:IsA("ProximityPrompt")
                    and prompt.ActionText:find("Steal") then

                    local position = GetPromptPosition(prompt)

                    if position then
                        local distance = (position - root.Position).Magnitude

                        if distance <= Config.StealRadius
                            and distance < nearestDistance then

                            nearest = prompt
                            nearestDistance = distance
                        end
                    end
                end
            end
        end
    end

    return nearest, nearestDistance
end

-- AUTO STEAL LOOP

local busy = false
local currentPrompt = nil

local function Interact(prompt)
    if busy or not Config.AutoSteal then return end
    if not prompt or not prompt.Enabled then return end

    busy = true
    currentPrompt = prompt

    Status.Text = "● INTERACTING..."
    Status.TextColor3 = Color3.fromRGB(255, 190, 70)

    local success, err = pcall(function()
        local root = GetRoot()
        local position = GetPromptPosition(prompt)

        if not root or not position then
            error("Target unavailable")
        end

        local distance = (position - root.Position).Magnitude

        if distance > prompt.MaxActivationDistance then
            error("Target outside interaction range")
        end

        prompt:InputHoldBegin()

        local duration = prompt.HoldDuration
        local started = os.clock()

        while os.clock() - started < duration do
            if not Config.AutoSteal or not prompt.Enabled then
                break
            end

            SetProgress(
                (os.clock() - started) / math.max(duration, 0.01)
            )

            task.wait(0.03)
        end

        prompt:InputHoldEnd()
    end)

    if success then
        Status.Text = "● INTERACTION FINISHED"
        Status.TextColor3 = Color3.fromRGB(80, 210, 140)
    else
        Status.Text = "● " .. tostring(err)
        Status.TextColor3 = Color3.fromRGB(255, 90, 90)
        warn("Keep Main:", err)
    end

    SetProgress(0)
    currentPrompt = nil
    busy = false
end

task.spawn(function()
    while Gui.Parent do
        if Config.AutoSteal and not busy then
            local success, prompt = pcall(FindNearestPrompt)

            if success and prompt then
                task.spawn(Interact, prompt)
            end
        end

        task.wait(Config.ScanDelay)
    end
end)

