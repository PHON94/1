            UDim2.fromOffset(10, 26),
            9,
            COLORS.Muted,
            false
        )
        descLabel.TextTruncate = Enum.TextTruncate.AtEnd
    end

    local switch = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(36, 19),
        BackgroundColor3 = Config[configKey] and COLORS.Accent or Color3.fromRGB(65, 72, 88),
        BorderSizePixel = 0,
    }, row)

    Corner(switch, 20)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(13, 13),
        Position = Config[configKey] and UDim2.new(1, -16, 0.5, -6) or UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
    }, switch)

    Corner(knob, 20)

    local function Refresh()
        local enabled = Config[configKey]
        Tween(switch, {
            BackgroundColor3 = enabled and COLORS.Accent or Color3.fromRGB(65, 72, 88),
        }, 0.13)

        Tween(knob, {
            Position = enabled and UDim2.new(1, -16, 0.5, -6) or UDim2.fromOffset(3, 3),
        }, 0.13)
    end

    row.MouseEnter:Connect(function()
        Tween(row, { BackgroundColor3 = COLORS.RowHover }, 0.12)
    end)

    row.MouseLeave:Connect(function()
        Tween(row, { BackgroundColor3 = COLORS.Row }, 0.12)
    end)

    row.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        Refresh()

        if callback then
            callback(Config[configKey])
        end
    end)

    return Refresh
end

local function AddSlider(parent, title, configKey, minimum, maximum, step, callback)
    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = COLORS.Row,
        BorderSizePixel = 0,
    }, parent)

    Corner(row, 7)

    MakeLabel(
        row,
        title,
        UDim2.new(1, -65, 0, 19),
        UDim2.fromOffset(10, 5),
        11,
        COLORS.Text,
        true
    )

    local valueLabel = MakeLabel(
        row,
        string.format("%.2f", Config[configKey]),
        UDim2.fromOffset(55, 19),
        UDim2.new(1, -63, 0, 5),
        10,
        COLORS.Accent,
        true
    )
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Create("Frame", {
        Position = UDim2.fromOffset(10, 34),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = Color3.fromRGB(60, 68, 83),
        BorderSizePixel = 0,
    }, row)

    Corner(track, 5)

    local fill = Create("Frame", {
        Size = UDim2.new(
            (Config[configKey] - minimum) / (maximum - minimum),
            0,
            1,
            0
        ),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, track)

    Corner(fill, 5)

    local hitbox = Create("TextButton", {
        Position = UDim2.new(0, 0, 0.5, -10),
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, track)

    local dragging = false

    local function SetFromX(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1),
            0,
            1
        )

        local value = minimum + (maximum - minimum) * alpha
        value = math.floor(value / step + 0.5) * step
        value = math.clamp(value, minimum, maximum)

        Config[configKey] = value
        fill.Size = UDim2.new(
            (value - minimum) / (maximum - minimum),
            0,
            1,
            0
        )
        valueLabel.Text = string.format("%.2f", value)

        if callback then
            callback(value)
        end
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            SetFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

